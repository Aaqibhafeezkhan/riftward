// Zone file. Room ids are local to this zone; link to another zone with "zone:room".
// This file is rewritten by in-game builder commands, so comments other than this header are lost.
(
    name: "Riftwatch Sewers",
    items: {
        "stale_crust": (
            name: "a stale crust",
            keywords: ["crust", "stale", "bread"],
            description: "A heel of bread, hard as wood and only a little nibbled.",
            bulk: Negligible,
            tags: ["food"],
            consumable: (by: Eat, recovery: (speed: 1.25, minutes: 5)),
            value: 1,
        ),
        "silver_locket": (
            name: "a tarnished silver locket",
            keywords: ["locket", "silver", "tarnished"],
            description: "A heavy silver locket on a broken chain, black with tarnish. The clasp is rusted shut.",
            bulk: Negligible,
            tags: ["valuable"],
            value: 200,
            rarity: Uncommon,
        ),
        "glowcap": (
            name: "a glowcap",
            keywords: ["glowcap", "fungus", "mushroom"],
            description: "A spongy fungus that glows a faint, sickly green in the dark. Not for eating.",
            bulk: Negligible,
            tags: ["herb"],
            value: 4,
            rarity: Uncommon,
        ),
        "rat_tail": (
            name: "a rat's tail",
            keywords: ["tail", "rat"],
            description: "A long, scaly rat's tail. Someone in town probably pays for these.",
            bulk: Negligible,
            tags: ["trophy"],
            value: 1,
        ),
        "kings_tooth": (
            name: "a yellowed tooth of the Rat King",
            keywords: ["tooth", "yellowed", "king"],
            description: "A long, curved incisor, yellow as old ivory and still sharp. Proof that the Rat King has fallen, for now.",
            bulk: Negligible,
            tags: ["trophy"],
            value: 67,
            rarity: Rare,
        ),
        "slime_jelly": (
            name: "a gob of slime jelly",
            keywords: ["jelly", "slime", "gob"],
            description: "A cold, quivering gob of grey jelly, all that's left of a slime. It smells of the cistern, and an apothecary might want it.",
            bulk: Negligible,
            tags: ["reagent"],
            value: 3,
        ),
        "heart_of_the_deep": (
            name: "a heart of the deep",
            keywords: ["heart", "deep"],
            description: "A fist-sized lump of dark, glassy jelly, cold as the cistern's water, with a faint pulse in it still. Whatever the Slime Lord was, this was the middle of it.",
            bulk: Light,
            tags: ["reagent", "trophy"],
            value: 80,
            rarity: Rare,
        ),
    },
    mobs: {
        "sewer_rat": (
            name: "a sewer rat",
            tags: ["vermin"],
            // Goes for anyone who isn't vermin: players, and the guards and dogs of the town.
            allies: ["vermin"],
            keywords: ["sewer", "rat"],
            here: "A sewer rat scurries along the edge of the channel.",
            description: "A fat, filthy rat as long as your forearm, not counting the tail. It watches you with bright black eyes and doesn't seem nearly as afraid as it should be.",
            attributes: {Body: 1, Strength: 1, Agility: 3, Reaction: 3},
            skills: {"beast:rat_bite": 2},
            attack: "beast:rat_bite",
            health: 3,
            loot: [[(None, 70), ("rat_tail", 30)]],
            coins: (0, 2),
            aggressive: true,
            // Rats keep out of the slimes' tunnels, or they'd drain into them and never break out.
            avoids: ["slime"],
        ),
        "courier": (
            name: "a courier",
            race: "human",
            keywords: ["courier", "smuggler", "wiry"],
            here: "A wiry courier crouches at the mouth of the culvert, a satchel hugged to their chest.",
            description: "Thin and quick, in clothes the colour of sewer stone, with a hood pulled close and a short blade within easy reach. The satchel they carry is held as if it matters more than they do. They watch the way back up to the stalls, not you, until you come close.",
            attributes: {Agility: 6, Reaction: 5, Strength: 3},
            skills: {"knives:basics": 12, "athletics:dodge": 10},
            attack: "knives:basics",
            coins: (20, 60),
        ),
        "giant_cockroach": (
            name: "a giant cockroach",
            tags: ["vermin"],
            allies: ["vermin"],
            keywords: ["giant", "cockroach", "roach"],
            here: "A giant cockroach clicks along the wall, feelers twitching.",
            description: "A cockroach the length of your hand, glossy brown and armoured, with feelers longer than its body. It's more interested in the muck than in you, and quicker than it looks.",
            attributes: {Body: 1, Strength: 1, Agility: 4, Reaction: 4},
            skills: {"beast:rat_bite": 1},
            attack: "beast:rat_bite",
            health: 2,
            avoids: ["slime"],
            traits: ["skittish"],
        ),
        "sewer_snake": (
            name: "a sewer snake",
            // Vermin, so the rats leave it be.
            tags: ["vermin"],
            keywords: ["sewer", "snake"],
            here: "A sewer snake lies coiled on a ledge above the water.",
            description: "A thin black snake as long as you are tall, with a pale belly and a flat, wedge-shaped head. It tastes the air as you come near, and its mouth is pink inside when it opens.",
            attributes: {Body: 1, Strength: 1, Agility: 4, Reaction: 4},
            skills: {"beast:bite": 3},
            attack: "beast:bite",
            health: 5,
            // Strikes at people who come near; leaves the rats be.
            aggressive: true,
            traits: ["venomous"],
        ),
        "ooze": (
            name: "an ooze",
            tags: ["slime"],
            allies: ["slime"],
            keywords: ["ooze", "slime"],
            here: "An ooze slides slowly across the wet stone.",
            description: "A knee-high heap of grey slime that moves like spilled porridge, leaving a clean, glistening trail on the stone behind it. Bits of things float inside it: a bone, a button, a rat's tooth.",
            attributes: {Body: 2, Strength: 1, Agility: 1, Reaction: 1},
            skills: {"beast:acid_touch": 2},
            attack: "beast:acid_touch",
            health: 4,
            loot: [[(None, 50), ("slime_jelly", 50)]],
            aggressive: true,
            traits: ["formless", "splitting"],
        ),
        "ooze_half": (
            name: "a torn-off ooze",
            tags: ["slime"],
            allies: ["slime"],
            keywords: ["torn", "ooze", "slime"],
            here: "A torn-off piece of ooze creeps along the stone.",
            description: "A fist of grey slime, torn from something bigger and still going about its business.",
            attributes: {Body: 1, Strength: 1, Agility: 1, Reaction: 1},
            skills: {"beast:acid_touch": 1},
            attack: "beast:acid_touch",
            health: 2,
            loot: [[(None, 80), ("slime_jelly", 20)]],
            aggressive: true,
            traits: ["formless"],
        ),
        "grey_slime": (
            name: "a grey slime",
            tags: ["slime"],
            allies: ["slime"],
            keywords: ["grey", "slime"],
            here: "A grey slime heaves itself along the tunnel.",
            description: "A waist-high mound of thick grey slime, tougher than an ooze and slower to give. Blows sink into it and it closes over them. Where it has passed, the stone is scoured clean.",
            attributes: {Body: 3, Strength: 3, Agility: 1, Reaction: 2},
            skills: {"beast:acid_touch": 4},
            attack: "beast:acid_touch",
            health: 12,
            loot: [[("slime_jelly", 100)], [(None, 70), ("slime_jelly", 30)]],
            aggressive: true,
            traits: ["formless", "rubbery"],
        ),
        "slime_lord": (
            name: "the Slime Lord",
            tags: ["slime"],
            allies: ["slime"],
            keywords: ["slime", "lord"],
            here: "The Slime Lord heaves in the black water, a mass of grey slime as big as a cart.",
            description: "A vast, slow mass of slime filling half the cistern, grey at the edges and black at the heart. Oozes slide from it and back into it. It has no eyes, but it knows you're here.",
            attributes: {Body: 6, Strength: 4, Agility: 2, Reaction: 3},
            skills: {"beast:acid_touch": 8, "beast:slime_lords_will": 1},
            attack: "beast:acid_touch",
            loot: [
                [("heart_of_the_deep", 100)],
                [("slime_jelly", 100)],
                [(None, 50), ("riftwatch:healing_draught", 50)],
            ],
            health: 40,
            tactics: 30,
            aggressive: true,
            boss: true,
            traits: ["formless", "rubbery", "mending", "shedding"],
        ),
        "rat_king": (
            name: "the Rat King",
            tags: ["vermin"],
            // Goes for anyone who isn't vermin: players, and the guards and dogs of the town.
            allies: ["vermin"],
            keywords: ["rat", "king"],
            here: "The Rat King squats on a mound of gnawed bones, a dozen tails knotted together beneath it.",
            description: "Not one rat but a seething knot of them, their tails fused into a single tangled mass, moving with one mind. Dozens of black eyes turn to follow you. It is the size of a dog, and it is hungry.",
            attributes: {Body: 6, Strength: 4, Agility: 5, Reaction: 5},
            skills: {"beast:bite": 8, "beast:claw": 8, "beast:rend": 8, "beast:rat_kings_command": 1},
            attack: "beast:claw",
            loot: [
                [("rat_tail", 60), ("kings_tooth", 40)],
                [(None, 70), ("riftwatch:healing_draught", 30)],
            ],
            health: 30,
            coins: (150, 400),
            tactics: 30,
            aggressive: true,
            boss: true,
        ),
    },
    spawns: {
        "sunken_locket": (
            item: "silver_locket",
            room: "sunken_hall",
            every: Hours(2),
            refill: Keep(1),
        ),
        "sunken_draught": (
            item: "riftwatch:healing_draught",
            room: "sunken_hall",
            every: Hours(1),
            refill: Keep(1),
        ),
        "sewer_rats": (
            mob: "sewer_rat",
            room: "nest",
            every: Minutes(20),
            refill: Breed(doubles_every: Hours(4), max: 200, reseed: Days(7), start: 8),
            wander: Anywhere(secs: (30, 120)),
            crowd: 6,
            pack: 3,
            breach: Some((
                packed: 8,
                room: "{actor} gnaws through {door}, and the rats pour after it!",
                beyond: "{door} gives way with a screech of rusted iron, gnawed through from below!",
            )),
        ),
        "rat_king": (
            mob: "rat_king",
            room: "nest",
            every: Minutes(1),
            refill: Keep(1),
            when: WorldFlag("rats_broke_out"),
        ),
        // A few more rats where they're thickest, which take a player on four at a time.
        "rat_swarm": (
            mob: "sewer_rat",
            room: "overflow_chamber",
            every: Minutes(30),
            refill: Keep(4),
            pack: 4,
        ),
        "cockroaches": (
            mob: "giant_cockroach",
            room: "north_trunk",
            every: Minutes(20),
            refill: Breed(doubles_every: Hours(2), max: 20, reseed: Days(1), start: 4),
            wander: Zone(secs: (30, 120)),
            crowd: 2,
        ),
        "sewer_snake": (
            mob: "sewer_snake",
            room: "flooded_tunnel",
            every: Minutes(30),
            refill: Keep(1),
        ),
        // The slimes keep to the west: the Cistern, the Western Tunnel and the Ossuary, where
        // they meet the rats.
        "oozes": (
            mob: "ooze",
            room: "cistern",
            every: Minutes(20),
            refill: Breed(doubles_every: Hours(4), max: 12, reseed: Days(2), start: 3),
            wander: Rooms(rooms: ["cistern", "tunnel_west", "ossuary"], secs: (60, 240)),
            crowd: 2,
            pack: 1,
        ),
        "grey_slimes": (
            mob: "grey_slime",
            room: "ossuary",
            every: Minutes(30),
            refill: Keep(2),
            pack: 1,
        ),
        "slime_lord": (
            mob: "slime_lord",
            room: "cistern",
            every: AfterDeath(Days(3)),
            refill: Keep(1),
        ),
    },
    events: {
        "rats_break_out": (
            when: All([
                Event(Entered(mob: "sewer_rat", zone: "riftwatch")),
                Not(WorldFlag("rats_broke_out")),
            ]),
            then: [
                SetWorldFlag("rats_broke_out"),
                Announce(Zone("riftwatch"), "Shrieks go up in the streets: rats are pouring out of the drains!"),
                Announce(Zone("sewers"), "Somewhere deep in the sewers, something huge squeals in triumph. The rats around you grow bold."),
            ],
        ),
        "slime_lord_slain": (
            when: Event(Died("slime_lord")),
            then: [
                Announce(Zone("sewers"), "A long, wet sigh rolls out of the Old Cistern, and every slime in the sewers goes still for a moment."),
            ],
        ),
        "rat_king_slain": (
            when: Event(Died("rat_king")),
            then: [
                ClearWorldFlag("rats_broke_out"),
                Announce(Everyone, "The Rat King is dead! The sewers fall quiet, and the rats lose their nerve, for now."),
            ],
        ),
    },
    finds: {
        Sewer: {
            "forage": [(None, 60), ("stale_crust", 40)],
            "herbs": [("glowcap", 1)],
        },
    },
    rooms: {
        "outflow_arch": (
            name: "Outflow Arch",
            description: "The main sewer ends at a great stone arch in the town wall, where the filth of Riftwatch pours out between thick iron bars into a ditch beyond. Daylight and fresh air slip through the bars, along with the sound of the world outside.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "south": "north_trunk",
            },
            environment: Sewer,
        ),
        "north_trunk": (
            name: "North Trunk",
            description: "The broadest tunnel in the sewers runs north beneath the gate road, its channel deep and fast. Cartwheels rumble overhead, shaking grit from the vaulted ceiling.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "north": "outflow_arch",
                "south": "market_drain",
                "east": "smugglers_nook",
                "up": (to: "riftwatch:north_gate", door: "riftwatch:gate_grate"),
            },
            environment: Sewer,
        ),
        "smugglers_nook": (
            name: "Smugglers' Nook",
            description: "A dry alcove has been bricked off from the tunnel and fitted with shelves. Someone has been using it: there are crate marks in the dust, a stub of candle, and a ledger page torn to pieces.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "west": "north_trunk",
            },
            environment: Sewer,
        ),
        "market_drain": (
            name: "Market Drain",
            description: "Beneath the market square, storm grates let in slivers of daylight and every scrap the stalls throw away. Rotten vegetables and worse pile against the walls, and footsteps pass back and forth overhead.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "north": "north_trunk",
                "south": "great_drain",
                "east": "stalls_culvert",
                "west": "guild_tunnel",
                "up": (to: "riftwatch:market", door: "riftwatch:market_grate"),
            },
            environment: Sewer,
        ),
        "stalls_culvert": (
            name: "Stalls Culvert",
            description: "A low culvert runs east under the vendor stalls. Spilled dyes stain the water in sickly streaks of blue and red.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "west": "market_drain",
                "east": "tunnel_east",
                "south": "outfall",
                "up": (to: "riftwatch:stalls", door: "riftwatch:stalls_grate"),
            },
            environment: Sewer,
        ),
        "outfall": (
            name: "Sewer Outfall",
            description: "Thin light falls through a rusted grate above onto a slick stone landing. Filthy water from the market drains collects here before running on into the dark.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "up": (to: "riftwatch:back_alley", door: "riftwatch:sewer_grate"),
                "north": "stalls_culvert",
                "west": "great_drain",
                "south": "garrison_drain",
            },
            environment: Sewer,
        ),
        "guild_tunnel": (
            name: "Guild Tunnel",
            description: "A well-built tunnel beneath Guild Row, its brickwork newer and its walkway wider. Somebody once paid to keep this stretch in good repair.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "east": "market_drain",
                "north": "guild_drain",
                "west": "tunnel_west",
                "up": (to: "riftwatch:guild_row", door: "riftwatch:guild_grate"),
            },
            environment: Sewer,
        ),
        "guild_drain": (
            name: "Guild Drain",
            description: "A short spur ends beneath the guildhall at an iron ladder, which climbs to a heavy hatch in the ceiling. Muffled voices and the scrape of chairs come through from above.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "south": "guild_tunnel",
                "up": (to: "riftwatch:guild_cellar", door: "riftwatch:guild_hatch"),
            },
            environment: Sewer,
        ),
        "tunnel_west": (
            name: "Western Tunnel",
            description: "A low brick tunnel, its ceiling furred with moss and dripping steadily. The walkway beside the channel is narrow and treacherous.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "east": "guild_tunnel",
                "west": "cistern",
                "south": "ossuary",
            },
            environment: Sewer,
        ),
        "cistern": (
            name: "Old Cistern",
            description: "The tunnel opens into a vaulted cistern, far older than the sewers around it. Black water stands still and deep beneath crumbling pillars, and the echoes come back wrong.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "east": "tunnel_west",
                "down": "drowned_stair",
            },
            environment: Sewer,
        ),
        "drowned_stair": (
            name: "Drowned Stair",
            description: "Worn steps descend from the cistern's edge into black water and vanish beneath it. Something was down there once, before the water came: the carvings on the walls are in no script you know.",
            terrain: Wading,
            indoors: true,
            exits: {
                "down": (to: "sunken_hall", needs: Swim(4)),
                "up": "cistern",
            },
            environment: Sewer,
        ),
        "sunken_hall": (
            name: "Sunken Hall",
            description: "You surface in a pocket of stale air beneath a vaulted ceiling. Pillars carved with the same strange script march away into the dark, and the water here is still and cold as a tomb. Whoever built this place, the city above was laid on top of it and forgotten.",
            terrain: Wading,
            indoors: true,
            exits: {
                "up": (to: "drowned_stair", needs: Swim(4)),
            },
            environment: Sewer,
        ),
        "ossuary": (
            name: "Ossuary",
            description: "Beneath the shrine, an old burial passage has been cut through by the sewers. Skulls and long bones are stacked in neat niches along the walls, and nothing down here has disturbed them.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "north": "tunnel_west",
                "east": "great_drain",
            },
            environment: Sewer,
        ),
        "great_drain": (
            name: "Great Drain",
            description: "The sewers' spine runs south beneath High Street, a tall arched tunnel where several channels meet and churn together. The roar of water fills the space.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "north": "market_drain",
                "east": "outfall",
                "west": "ossuary",
                "south": "keep_drain",
                "up": (to: "riftwatch:high_street", door: "riftwatch:high_street_grate"),
            },
            environment: Sewer,
        ),
        "keep_drain": (
            name: "Keep Drain",
            description: "The tunnel grows deeper and colder beneath the keep's foundations. The stone here is massive and dressed with care, built to hold up walls rather than to carry filth.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "north": "great_drain",
                "east": "garrison_drain",
                "south": "sluice",
            },
            environment: Sewer,
        ),
        "sluice": (
            name: "Sluice",
            description: "A rusted sluice gate holds back a pool of stagnant water at the end of the keep's drain. Set into the wall above it, a stout iron door leads up toward the keep's lowest levels.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "north": "keep_drain",
                "up": (to: "riftwatch:keep_dungeon", door: "riftwatch:dungeon_door"),
            },
            environment: Sewer,
        ),
        "garrison_drain": (
            name: "Garrison Drain",
            description: "A barred grate overhead lets in the tramp of marching boots and the barked orders of the garrison yard. The drain beneath is choked with mud and spent straw from the stables.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "up": (to: "riftwatch:garrison_yard", door: "riftwatch:garrison_grate"),
                "north": "outfall",
                "west": "keep_drain",
                "east": "flooded_tunnel",
            },
            environment: Sewer,
        ),
        "flooded_tunnel": (
            name: "Flooded Tunnel",
            description: "A collapsed section has dammed the channel, and the tunnel here stands waist-deep in cold, filthy water. Things bump against your legs in the murk.",
            terrain: Wading,
            indoors: true,
            exits: {
                "west": "garrison_drain",
                "north": "tunnel_east",
            },
            environment: Sewer,
        ),
        "tunnel_east": (
            name: "Eastern Tunnel",
            description: "The tunnel narrows and the stink thickens. Scratching echoes from somewhere ahead, and small tracks crisscross the muck on the walkway.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "west": "stalls_culvert",
                "south": "flooded_tunnel",
                "east": "rat_runs",
            },
            environment: Sewer,
        ),
        "rat_runs": (
            name: "Rat Runs",
            description: "The brickwork here is honeycombed with burrows, gnawed through mortar and earth alike. The walls squeak and rustle, and dozens of small passages branch off too narrow for anything larger than a rat.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "west": "tunnel_east",
                "east": "collapsed_gallery",
                "south": "overflow_chamber",
            },
            environment: Sewer,
        ),
        "collapsed_gallery": (
            name: "Collapsed Gallery",
            description: "Half of the ceiling has fallen in, leaving a slope of rubble to climb over. Rats scatter across the debris at every step.",
            terrain: Rough,
            indoors: true,
            exits: {
                "west": "rat_runs",
                "south": "nest",
            },
            environment: Sewer,
        ),
        "overflow_chamber": (
            name: "Overflow Chamber",
            description: "A wide chamber built to hold floodwater, now a shallow, reeking lake. Its edges are crowded with rats, and the overflow channels lead off into the rest of the sewers.",
            terrain: Wading,
            indoors: true,
            exits: {
                "north": "rat_runs",
                "east": "nest",
            },
            environment: Sewer,
        ),
        "nest": (
            name: "The Warren",
            description: "A collapsed section of tunnel heaped with rubbish, gnawed bones and shredded cloth. The heaps shift and rustle, and countless small eyes catch what little light there is.",
            terrain: Rough,
            indoors: true,
            exits: {
                "north": "collapsed_gallery",
                "west": "overflow_chamber",
            },
            environment: Sewer,
        ),
    },
)
