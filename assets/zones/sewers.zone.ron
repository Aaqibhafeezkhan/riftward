// Zone file. Room ids are local to this zone; link to another zone with "zone:room".
// This file is rewritten by in-game builder commands, so comments other than this header are lost.
(
    name: "Riftwatch Sewers",
    items: {
        "stale_crust": (
            name: "a stale crust",
            keywords: ["crust", "stale", "bread"],
            description: "A heel of bread, hard as wood and only a little nibbled.",
            bulk: Negligible,
            tags: ["food"],
            consumable: (by: Eat, recovery: (speed: 1.25, minutes: 5)),
            value: 1,
        ),
        "silver_locket": (
            name: "a tarnished silver locket",
            keywords: ["locket", "silver", "tarnished"],
            description: "A heavy silver locket on a broken chain, black with tarnish. The clasp is rusted shut.",
            bulk: Negligible,
            tags: ["valuable"],
            value: 200,
            rarity: Uncommon,
        ),
        "glowcap": (
            name: "a glowcap",
            keywords: ["glowcap", "fungus", "mushroom"],
            description: "A spongy fungus that glows a faint, sickly green in the dark. Not for eating.",
            bulk: Negligible,
            tags: ["herb"],
            value: 4,
            rarity: Uncommon,
        ),
        "rat_tail": (
            name: "a rat's tail",
            keywords: ["tail", "rat"],
            description: "A long, scaly rat's tail. Someone in town probably pays for these.",
            bulk: Negligible,
            tags: ["trophy"],
            value: 1,
        ),
        "kings_tooth": (
            name: "a yellowed tooth of the Rat King",
            keywords: ["tooth", "yellowed", "king"],
            description: "A long, curved incisor, yellow as old ivory and still sharp. Proof that the Rat King has fallen, for now.",
            bulk: Negligible,
            tags: ["trophy"],
            value: 67,
            rarity: Rare,
        ),
    },
    mobs: {
        "sewer_rat": (
            name: "a sewer rat",
            keywords: ["sewer", "rat"],
            here: "A sewer rat scurries along the edge of the channel.",
            description: "A fat, filthy rat as long as your forearm, not counting the tail. It watches you with bright black eyes and doesn't seem nearly as afraid as it should be.",
            attributes: {Body: 1, Strength: 1, Agility: 3, Reaction: 3},
            skills: {"beast:rat_bite": 2},
            attack: "beast:rat_bite",
            health: 3,
            loot: [[(None, 70), ("rat_tail", 30)]],
            coins: (0, 2),
            aggressive: true,
        ),
        "rat_king": (
            name: "the Rat King",
            keywords: ["rat", "king"],
            here: "The Rat King squats on a mound of gnawed bones, a dozen tails knotted together beneath it.",
            description: "Not one rat but a seething knot of them, their tails fused into a single tangled mass, moving with one mind. Dozens of black eyes turn to follow you. It is the size of a dog, and it is hungry.",
            attributes: {Body: 6, Strength: 4, Agility: 5, Reaction: 5},
            skills: {"beast:bite": 8, "beast:claw": 8, "beast:rend": 8, "beast:rat_kings_command": 1},
            attack: "beast:claw",
            loot: [
                [("rat_tail", 60), ("kings_tooth", 40)],
                [(None, 70), ("riftwatch:healing_draught", 30)],
            ],
            health: 30,
            coins: (150, 400),
            tactics: 30,
            aggressive: true,
        ),
    },
    spawns: {
        "sunken_locket": (
            item: "silver_locket",
            room: "sunken_hall",
            every: Hours(2),
            refill: Keep(1),
        ),
        "sunken_draught": (
            item: "riftwatch:healing_draught",
            room: "sunken_hall",
            every: Hours(1),
            refill: Keep(1),
        ),
        "sewer_rats": (
            mob: "sewer_rat",
            room: "nest",
            every: Minutes(20),
            refill: Breed(doubles_every: Hours(4), max: 200, reseed: Days(7), start: 8),
            wander: Anywhere(secs: (30, 120)),
            crowd: 6,
            pack: 3,
            breach: Some((
                packed: 8,
                room: "{actor} gnaws through {door}, and the rats pour after it!",
                beyond: "{door} gives way with a screech of rusted iron, gnawed through from below!",
            )),
        ),
        "rat_king": (
            mob: "rat_king",
            room: "nest",
            every: Minutes(1),
            refill: Keep(1),
            when: WorldFlag("rats_broke_out"),
        ),
    },
    events: {
        "rats_break_out": (
            when: All([
                Event(Entered(mob: "sewer_rat", zone: "riftwatch")),
                Not(WorldFlag("rats_broke_out")),
            ]),
            then: [
                SetWorldFlag("rats_broke_out"),
                Announce(Zone("riftwatch"), "Shrieks go up in the streets: rats are pouring out of the drains!"),
                Announce(Zone("sewers"), "Somewhere deep in the sewers, something huge squeals in triumph. The rats around you grow bold."),
            ],
        ),
        "rat_king_slain": (
            when: Event(Died("rat_king")),
            then: [
                ClearWorldFlag("rats_broke_out"),
                Announce(Everyone, "The Rat King is dead! The sewers fall quiet, and the rats lose their nerve, for now."),
            ],
        ),
    },
    finds: {
        Sewer: {
            "forage": [(None, 60), ("stale_crust", 40)],
            "herbs": [("glowcap", 1)],
        },
    },
    rooms: {
        "outflow_arch": (
            name: "Outflow Arch",
            description: "The main sewer ends at a great stone arch in the town wall, where the filth of Riftwatch pours out between thick iron bars into a ditch beyond. Daylight and fresh air slip through the bars, along with the sound of the world outside.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "south": "north_trunk",
            },
            environment: Sewer,
        ),
        "north_trunk": (
            name: "North Trunk",
            description: "The broadest tunnel in the sewers runs north beneath the gate road, its channel deep and fast. Cartwheels rumble overhead, shaking grit from the vaulted ceiling.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "north": "outflow_arch",
                "south": "market_drain",
                "east": "smugglers_nook",
                "up": (to: "riftwatch:north_gate", door: "riftwatch:gate_grate"),
            },
            environment: Sewer,
        ),
        "smugglers_nook": (
            name: "Smugglers' Nook",
            description: "A dry alcove has been bricked off from the tunnel and fitted with shelves. Someone has been using it: there are crate marks in the dust, a stub of candle, and a ledger page torn to pieces.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "west": "north_trunk",
            },
            environment: Sewer,
        ),
        "market_drain": (
            name: "Market Drain",
            description: "Beneath the market square, storm grates let in slivers of daylight and every scrap the stalls throw away. Rotten vegetables and worse pile against the walls, and footsteps pass back and forth overhead.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "north": "north_trunk",
                "south": "great_drain",
                "east": "stalls_culvert",
                "west": "guild_tunnel",
                "up": (to: "riftwatch:market", door: "riftwatch:market_grate"),
            },
            environment: Sewer,
        ),
        "stalls_culvert": (
            name: "Stalls Culvert",
            description: "A low culvert runs east under the vendor stalls. Spilled dyes stain the water in sickly streaks of blue and red.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "west": "market_drain",
                "east": "tunnel_east",
                "south": "outfall",
                "up": (to: "riftwatch:stalls", door: "riftwatch:stalls_grate"),
            },
            environment: Sewer,
        ),
        "outfall": (
            name: "Sewer Outfall",
            description: "Thin light falls through a rusted grate above onto a slick stone landing. Filthy water from the market drains collects here before running on into the dark.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "up": (to: "riftwatch:back_alley", door: "riftwatch:sewer_grate"),
                "north": "stalls_culvert",
                "west": "great_drain",
                "south": "garrison_drain",
            },
            environment: Sewer,
        ),
        "guild_tunnel": (
            name: "Guild Tunnel",
            description: "A well-built tunnel beneath Guild Row, its brickwork newer and its walkway wider. Somebody once paid to keep this stretch in good repair.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "east": "market_drain",
                "north": "guild_drain",
                "west": "tunnel_west",
                "up": (to: "riftwatch:guild_row", door: "riftwatch:guild_grate"),
            },
            environment: Sewer,
        ),
        "guild_drain": (
            name: "Guild Drain",
            description: "A short spur ends beneath the guildhall at an iron ladder, which climbs to a heavy hatch in the ceiling. Muffled voices and the scrape of chairs come through from above.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "south": "guild_tunnel",
                "up": (to: "riftwatch:guild_cellar", door: "riftwatch:guild_hatch"),
            },
            environment: Sewer,
        ),
        "tunnel_west": (
            name: "Western Tunnel",
            description: "A low brick tunnel, its ceiling furred with moss and dripping steadily. The walkway beside the channel is narrow and treacherous.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "east": "guild_tunnel",
                "west": "cistern",
                "south": "ossuary",
            },
            environment: Sewer,
        ),
        "cistern": (
            name: "Old Cistern",
            description: "The tunnel opens into a vaulted cistern, far older than the sewers around it. Black water stands still and deep beneath crumbling pillars, and the echoes come back wrong.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "east": "tunnel_west",
                "down": "drowned_stair",
            },
            environment: Sewer,
        ),
        "drowned_stair": (
            name: "Drowned Stair",
            description: "Worn steps descend from the cistern's edge into black water and vanish beneath it. Something was down there once, before the water came: the carvings on the walls are in no script you know.",
            terrain: Wading,
            indoors: true,
            exits: {
                "down": (to: "sunken_hall", needs: Swim(4)),
                "up": "cistern",
            },
            environment: Sewer,
        ),
        "sunken_hall": (
            name: "Sunken Hall",
            description: "You surface in a pocket of stale air beneath a vaulted ceiling. Pillars carved with the same strange script march away into the dark, and the water here is still and cold as a tomb. Whoever built this place, the city above was laid on top of it and forgotten.",
            terrain: Wading,
            indoors: true,
            exits: {
                "up": (to: "drowned_stair", needs: Swim(4)),
            },
            environment: Sewer,
        ),
        "ossuary": (
            name: "Ossuary",
            description: "Beneath the shrine, an old burial passage has been cut through by the sewers. Skulls and long bones are stacked in neat niches along the walls, and nothing down here has disturbed them.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "north": "tunnel_west",
                "east": "great_drain",
            },
            environment: Sewer,
        ),
        "great_drain": (
            name: "Great Drain",
            description: "The sewers' spine runs south beneath High Street, a tall arched tunnel where several channels meet and churn together. The roar of water fills the space.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "north": "market_drain",
                "east": "outfall",
                "west": "ossuary",
                "south": "keep_drain",
                "up": (to: "riftwatch:high_street", door: "riftwatch:high_street_grate"),
            },
            environment: Sewer,
        ),
        "keep_drain": (
            name: "Keep Drain",
            description: "The tunnel grows deeper and colder beneath the keep's foundations. The stone here is massive and dressed with care, built to hold up walls rather than to carry filth.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "north": "great_drain",
                "east": "garrison_drain",
                "south": "sluice",
            },
            environment: Sewer,
        ),
        "sluice": (
            name: "Sluice",
            description: "A rusted sluice gate holds back a pool of stagnant water at the end of the keep's drain. Set into the wall above it, a stout iron door leads up toward the keep's lowest levels.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "north": "keep_drain",
                "up": (to: "riftwatch:keep_dungeon", door: "riftwatch:dungeon_door"),
            },
            environment: Sewer,
        ),
        "garrison_drain": (
            name: "Garrison Drain",
            description: "A barred grate overhead lets in the tramp of marching boots and the barked orders of the garrison yard. The drain beneath is choked with mud and spent straw from the stables.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "up": (to: "riftwatch:garrison_yard", door: "riftwatch:garrison_grate"),
                "north": "outfall",
                "west": "keep_drain",
                "east": "flooded_tunnel",
            },
            environment: Sewer,
        ),
        "flooded_tunnel": (
            name: "Flooded Tunnel",
            description: "A collapsed section has dammed the channel, and the tunnel here stands waist-deep in cold, filthy water. Things bump against your legs in the murk.",
            terrain: Wading,
            indoors: true,
            exits: {
                "west": "garrison_drain",
                "north": "tunnel_east",
            },
            environment: Sewer,
        ),
        "tunnel_east": (
            name: "Eastern Tunnel",
            description: "The tunnel narrows and the stink thickens. Scratching echoes from somewhere ahead, and small tracks crisscross the muck on the walkway.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "west": "stalls_culvert",
                "south": "flooded_tunnel",
                "east": "rat_runs",
            },
            environment: Sewer,
        ),
        "rat_runs": (
            name: "Rat Runs",
            description: "The brickwork here is honeycombed with burrows, gnawed through mortar and earth alike. The walls squeak and rustle, and dozens of small passages branch off too narrow for anything larger than a rat.",
            terrain: Uneven,
            indoors: true,
            exits: {
                "west": "tunnel_east",
                "east": "collapsed_gallery",
                "south": "overflow_chamber",
            },
            environment: Sewer,
        ),
        "collapsed_gallery": (
            name: "Collapsed Gallery",
            description: "Half of the ceiling has fallen in, leaving a slope of rubble to climb over. Rats scatter across the debris at every step.",
            terrain: Rough,
            indoors: true,
            exits: {
                "west": "rat_runs",
                "south": "nest",
            },
            environment: Sewer,
        ),
        "overflow_chamber": (
            name: "Overflow Chamber",
            description: "A wide chamber built to hold floodwater, now a shallow, reeking lake. Its edges are crowded with rats, and the overflow channels lead off into the rest of the sewers.",
            terrain: Wading,
            indoors: true,
            exits: {
                "north": "rat_runs",
                "east": "nest",
            },
            environment: Sewer,
        ),
        "nest": (
            name: "The Warren",
            description: "A collapsed section of tunnel heaped with rubbish, gnawed bones and shredded cloth. The heaps shift and rustle, and countless small eyes catch what little light there is.",
            terrain: Rough,
            indoors: true,
            exits: {
                "north": "collapsed_gallery",
                "west": "overflow_chamber",
            },
            environment: Sewer,
        ),
    },
)
