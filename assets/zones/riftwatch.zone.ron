    mobs: {
        "training_dummy": (
            name: "a straw training dummy",
            keywords: ["dummy", "straw", "training"],
            here: "A straw training dummy stands on its post, hacked and patched many times over.",
            description: "A man-shaped bundle of straw lashed to a stout post, wearing a dented pot for a helm. It has been slashed, stabbed, punched and set on fire, and patched after every one. It doesn't hit back, which is the whole idea.",
            // A thing: it takes blows and never gives one, is worth no experience, and leaves no
            // corpse. Townsfolk, so the guards leave it be.
            tags: ["townsfolk"],
            traits: ["inanimate"],
            attributes: {Body: 1, Agility: 1, Reaction: 1},
            health: 40,
        ),
        "town_guard": (
            name: "a town guard",
            tags: ["townsfolk"],
            // Goes for any stranger to the town, a rat or worse; never townsfolk or players.
            allies: ["townsfolk", "players"],
            aggressive: true,
            race: "human",
            keywords: ["town", "guard", "watchman"],
            here: "A town guard keeps watch, one hand resting on the hilt of a short sword.",
            description: "A broad-shouldered watchman in a dented helm and a tabard faded from Riftwatch's colours to something closer to grey. They look bored, which is not the same as inattentive.",
            attributes: {Body: 6, Strength: 5, Agility: 4, Reaction: 4},
            skills: {
                "brawling:basics": 10, "brawling:grapple": 5, "swordplay:basics": 10,
                "swordplay:lunge": 5, "swordplay:riposte": 5, "athletics:dodge": 5,
                "shields:block": 5, "armour:heavy_armour": 5, "command:call_for_help": 1,
            },
            equipment: ["short_sword", "round_shield", "studded_leather", "iron_helm"],
            coins: (5, 30),
        ),
        "stray_dog": (
            name: "a stray dog",
            tags: ["townsfolk"],
            // Goes for any stranger to the town, a rat or worse; never townsfolk or players.
            allies: ["townsfolk", "players"],
            aggressive: true,
            keywords: ["stray", "dog", "mutt"],
            here: "A scruffy stray dog noses through the gutter for scraps.",
            description: "A lean, rangy mutt of no particular breed, with one torn ear and a hopeful tail. Every market stall-keeper knows it, and most of them pretend not to feed it.",
            attributes: {Body: 2, Strength: 2, Agility: 4, Reaction: 5},
            skills: {"beast:bite": 3},
            attack: "beast:bite",
            health: 6,
        ),
        "contract_clerk": (
            name: "Marin Harrow",
            tags: ["townsfolk"],
            race: "elf",
            keywords: ["marin", "harrow", "contract", "clerk", "receptionist"],
            here: "Marin Harrow sits behind the counter, heaped with ledgers, pen scratching.",
            description: "A half-elven woman with auburn hair pinned in a neat bun and piercing green eyes that miss nothing, a silver brooch of rank at her collar. She keeps the guild's contracts, its ledgers and its members' tags, and pays out when the work is done. Meticulous, fair and blunt, she has a soft spot for rookies she'd never admit to, and she remembers everyone who has ever failed to finish a job.",
        ),
        "herbalist": (
            name: "Narina Greenthorn",
            tags: ["townsfolk"],
            race: "elf",
            keywords: ["narina", "greenthorn", "herbalist", "woman"],
            here: "Narina Greenthorn sorts dried leaves into bundles, muttering their names.",
            description: "A half-elven woman with a silver-streaked chestnut braid, herb-stained hands and a moss-green apron, an oak-leaf pendant at her throat. She smells of mint and something less pleasant underneath, and has a lecture ready for anyone who comes back from the woods bleeding. Some of the cuttings drying behind her stall are not quite the colour they should be.",
            attributes: {Charisma: 3},
            skills: {"trade:haggling": 2},
            teaches: ["healing:first_aid", "nature:herbalism", "survival:foraging"],
            shop: (
                sells: ["bandage", "healing_draught"],
                buys: ["herb", "potion", "bandage"],
            ),
        ),
        "provisioner": (
            name: "Harwin Colm",
            tags: ["townsfolk"],
            race: "human",
            keywords: ["harwin", "colm", "provisioner", "stallholder", "merchant", "farmer"],
            here: "Harwin Colm leans on a counter stacked with loaves, packs and folded cloth, calling out prices.",
            description: "A round, red-cheeked farmer in a leather apron, with a pencil behind one ear and a ledger he never lets out of reach. Half his stock comes off his own fields, and he'll tell you, unasked, which wild plants are safe to eat. He can tell you to the copper what anything in the market is worth, and what he'll pay for it, which is less.",
            attributes: {Charisma: 4},
            skills: {"trade:haggling": 4},
            teaches: ["trade:haggling", "trade:appraisal"],
            shop: (
                sells: [
                    "bread", "water_flask", "waterskin", "torch", "backpack", "belt_pouch",
                    "potion_pouch", "scroll_tube", "keyring", "plain_clothes", "travelers_coat",
                    "padded_jack", "leather_jerkin", "leather_cap", "leather_gloves", "leather_leggings",
                ],
                buys: ["food", "drink", "container", "armour"],
            ),
        ),
        "tinker": (
            name: "Brynn Corlack",
            tags: ["townsfolk"],
            race: "dwarf",
            keywords: ["brynn", "corlack", "smith", "tinker", "mender"],
            here: "Brynn Corlack sits at a cluttered bench, hammering a dent out of a pot.",
            description: "A broad-shouldered dwarf woman with an ash-grey braid, soot to her elbows and a burn-scarred apron. The best smith in Riftwatch, she supplies the Fort's armory, and between commissions her bench is heaped with blades to sharpen, locks to mend and things nobody else wanted. Gruff, honest and a perfectionist, she'll buy almost anything if the price is low enough, and sell nothing she wouldn't carry herself.",
            attributes: {Charisma: 4},
            skills: {"trade:haggling": 6},
            shop: (
                sells: [
                    "knife", "hatchet", "quarterstaff", "smiths_hammer", "lockpicks", "sword_sheath",
                    "weapon_loop", "buckler",
                ],
                buys: ["anything"],
            ),
        ),
        "hooded_figure": (
            name: "a hooded figure",
            tags: ["townsfolk"],
            race: "human",
            keywords: ["hooded", "figure", "stranger", "talla", "mirk"],
            here: "A hooded figure leans in a doorway, so still you almost missed her.",
            description: "A slight woman in a patched grey cloak, hood drawn low. Her hands never stop moving: a coin walking across the knuckles, a pick turning in the fingers. Those who know the back alley call her Talla Mirk, and say she can get anything, rare, dangerous or crystal, for a price and no questions. For the right price, or the right reason, she teaches what she knows.",
            attributes: {Agility: 7, Reaction: 6, Intuition: 6},
            skills: {"brawling:basics": 10, "athletics:dodge": 15, "stealth:basics": 20},
            teaches: ["stealth:basics", "thievery:lockpicking", "thievery:pickpocketing"],
        ),
        "drill_sergeant": (
            name: "Sergeant Alina Greaves",
            tags: ["townsfolk"],
            race: "ork",
            keywords: ["alina", "greaves", "drill", "sergeant"],
            here: "Sergeant Alina Greaves paces the yard, barking at anyone who stands still.",
            description: "A grizzled ork veteran with a voice like a rockslide and a wooden practice sword that has broken more knuckles than any real blade. She has the Fort's recruits and the guild's novices alike, and judges them the same way: by whether they get up again.",
            attributes: {Body: 7, Strength: 6, Agility: 5, Reaction: 5},
            skills: {
                "brawling:basics": 20, "brawling:grapple": 10, "brawling:kick": 10,
                "swordplay:basics": 20, "swordplay:lunge": 10, "swordplay:riposte": 10,
                "athletics:dodge": 10,
            },
            equipment: ["practice_sword"],
            tactics: 40,
            teaches: [
                "swordplay:basics", "knives:basics", "axes:basics", "hammers:basics", "staves:basics",
                "athletics:toughness", "athletics:climbing", "athletics:swimming",
                "armour:heavy_armour", "shields:block",
            ],
        ),
        "shrine_keeper": (
            name: "the keeper of the shrine",
            tags: ["townsfolk"],
            race: "human",
            keywords: ["keeper", "shrine", "priestess"],
            here: "The keeper of the shrine tends the candles, murmuring a prayer over each.",
            description: "A calm-faced woman in a faded grey habit, wax spattered across her sleeves. Her eyes rest on each visitor a moment longer than is comfortable, as if listening for something.",
            attributes: {Intuition: 6, Willpower: 6, Magic: 4},
            skills: {"divine:foundation": 20},
            spells: ["divine:mend", "divine:bless"],
            teaches: ["divine:foundation", "divine:mend", "divine:bless"],
        ),
        "magister": (
            name: "the magister",
            tags: ["townsfolk"],
            race: "elf",
            keywords: ["magister", "scholar", "mage"],
            here: "The magister sits at the reading desk, quill scratching beside a towering stack of books.",
            description: "An elderly scholar with ink-black fingertips and spectacles on a chain. The guild keeps him for his learning; he keeps the guild's grimoires, and teaches the rare few with the spark to read them.",
            attributes: {Logic: 6, Willpower: 5, Magic: 4},
            skills: {"hermetic:foundation": 20},
            spells: ["hermetic:spark", "hermetic:ward"],
            teaches: ["hermetic:foundation", "hermetic:spark", "hermetic:ward", "hermetic:kindle_blade"],
        ),
        "ascetic": (
            name: "an old ascetic",
            tags: ["townsfolk"],
            race: "human",
            keywords: ["old", "ascetic", "monk"],
            here: "An old ascetic sits cross-legged at the parapet, breathing slowly, utterly still.",
            description: "Thin as a rake and brown as a nut, wearing little more than a loincloth despite the wind. The guards say he has sat here since before the barrier rose. His stillness has a weight to it, like a drawn bow.",
            teaches: ["adept:foundation"],
        ),
    },
