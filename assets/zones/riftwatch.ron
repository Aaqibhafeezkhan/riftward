// Zone file. Room ids are local to this zone; link to another zone with "zone:room".
// This file is rewritten by in-game builder commands, so comments other than this header are lost.
(
    name: "Riftwatch",
    doors: {
        "guild_doors": (
            name: "a pair of iron-banded doors",
            keywords: ["doors", "door", "iron", "guild"],
            state: Open,
        ),
        "armory_door": (
            name: "a reinforced armory door",
            keywords: ["door", "armory", "reinforced"],
            state: Locked,
            lock: Some((key: Some("armory_key"), pick: Some(8), bash: Some(20))),
        ),
        "keep_gates": (
            name: "an iron-studded gate",
            keywords: ["gate", "gates", "keep", "iron"],
            state: Open,
            lock: Some((bash: Some(40))),
        ),
        "solar_door": (
            name: "a carved oak door",
            keywords: ["door", "oak", "carved"],
            state: Locked,
            lock: Some((key: Some("solar_key"), pick: Some(10), bash: Some(25))),
        ),
        "sewer_grate": (
            name: "a rusted sewer grate",
            keywords: ["grate", "sewer", "rusted"],
            state: Closed,
        ),
        "gate_grate": (
            name: "an iron storm grate",
            keywords: ["grate", "storm", "iron"],
            state: Closed,
        ),
        "market_grate": (
            name: "a storm grate",
            keywords: ["grate", "storm"],
            state: Closed,
        ),
        "guild_grate": (
            name: "a drain grate",
            keywords: ["grate", "drain"],
            state: Closed,
        ),
        "high_street_grate": (
            name: "a broad iron grate",
            keywords: ["grate", "iron", "broad"],
            state: Closed,
        ),
        "stalls_grate": (
            name: "a gutter grate",
            keywords: ["grate", "gutter"],
            state: Closed,
        ),
        "guild_hatch": (
            name: "an iron hatch",
            keywords: ["hatch", "iron"],
            state: Locked,
            lock: Some((key: Some("cellar_key"), pick: Some(6), bash: Some(15))),
        ),
        "garrison_grate": (
            name: "a barred drain grate",
            keywords: ["grate", "drain", "barred"],
            state: Locked,
            lock: Some((key: Some("armory_key"), pick: Some(6), bash: Some(20))),
        ),
        "dungeon_door": (
            name: "a rusted iron door",
            keywords: ["door", "iron", "rusted"],
            state: Locked,
            lock: Some((key: Some("dungeon_key"), pick: Some(12), bash: Some(40))),
        ),
    },
    items: {
        "armory_key": (
            name: "an iron armory key",
            keywords: ["key", "iron", "armory"],
            description: "A heavy iron key on a leather thong, stamped with the garrison's mark. It opens the armory and the drain grate in the garrison yard.",
            bulk: Negligible,
            tags: ["key"],
        ),
        "solar_key": (
            name: "an ornate brass key",
            keywords: ["key", "brass", "ornate", "solar"],
            description: "A small brass key, its bow worked into the shape of a watchful eye.",
            bulk: Negligible,
            tags: ["key"],
        ),
        "cellar_key": (
            name: "a stubby cellar key",
            keywords: ["key", "stubby", "cellar"],
            description: "A short, greasy key with the guild's crossed sword and lantern scratched into it.",
            bulk: Negligible,
            tags: ["key"],
        ),
        "dungeon_key": (
            name: "a rusted dungeon key",
            keywords: ["key", "rusted", "dungeon"],
            description: "A long key, red with rust, that looks as though it opens something nobody has wanted opened in years.",
            bulk: Negligible,
            tags: ["key"],
        ),
        "chest_key": (
            name: "a little copper key",
            keywords: ["key", "copper", "little"],
            description: "A little copper key, green at the edges.",
            bulk: Negligible,
            tags: ["key"],
        ),
        "torch": (
            name: "a pitch torch",
            keywords: ["torch", "pitch"],
            description: "A length of wood wrapped in pitch-soaked rags, ready to be lit.",
        ),
        "practice_sword": (
            name: "a wooden practice sword",
            keywords: ["sword", "wooden", "practice"],
            description: "A blunt wooden sword, scarred from countless drills in the training yard.",
            bulk: Bulk(1),
            tags: ["blade"],
            weapon: (skill: "swordplay:basics", damage: (1, 3)),
        ),
        "short_sword": (
            name: "a short sword",
            keywords: ["sword", "short"],
            description: "A plain, serviceable blade, a little longer than a forearm, in a scuffed leather grip.",
            bulk: Bulk(1),
            tags: ["blade"],
            weapon: (skill: "swordplay:basics", damage: (2, 5)),
        ),
        "knife": (
            name: "a knife",
            keywords: ["knife", "blade"],
            description: "A plain knife with a wooden handle, good for bread, rope and worse.",
            tags: ["blade"],
            weapon: (skill: "knives:basics", damage: (1, 4)),
        ),
        "quarterstaff": (
            name: "a quarterstaff",
            keywords: ["quarterstaff", "staff"],
            description: "A length of seasoned ash as tall as a man, worn smooth where the hands go.",
            bulk: Bulk(1),
            weapon: (skill: "staves:basics", damage: (1, 4)),
        ),
        "smiths_hammer": (
            name: "a smith's hammer",
            keywords: ["hammer", "smith"],
            description: "A heavy cross-peen hammer, its face polished bright by years at the anvil.",
            bulk: Bulk(1),
            tags: ["tool"],
            weapon: (skill: "hammers:basics", damage: (2, 5)),
        ),
        "lockpicks": (
            name: "a set of lockpicks",
            keywords: ["lockpicks", "picks", "set"],
            description: "A roll of oiled leather holding thin hooks, rakes and a tension wrench.",
            bulk: Negligible,
            tags: ["lockpick", "tool"],
        ),
        "plain_clothes": (
            name: "a set of plain clothes",
            keywords: ["clothes", "plain", "set"],
            description: "A homespun shirt, breeches and a jerkin, patched but sturdy.",
            wear: Body,
        ),
        "bread": (
            name: "a loaf of bread",
            keywords: ["bread", "loaf"],
            description: "A dense brown loaf, still faintly warm from the baker's oven.",
            tags: ["food"],
        ),
        "waterskin": (
            name: "a waterskin",
            keywords: ["waterskin", "skin"],
            description: "A stitched leather waterskin with a wooden stopper.",
        ),
        "scroll": (
            name: "a rolled parchment",
            keywords: ["scroll", "parchment"],
            description: "A sheet of parchment, rolled tight and tied with string.",
            tags: ["scroll"],
        ),
        "healing_draught": (
            name: "a healing draught",
            keywords: ["draught", "potion", "healing"],
            description: "A stoppered vial of cloudy red liquid that smells of honey and iron.",
            tags: ["potion"],
        ),
        "backpack": (
            name: "a leather backpack",
            keywords: ["backpack", "pack", "leather"],
            description: "A sturdy leather pack with two shoulder straps and a buckled flap.",
            bulk: Bulk(1),
            wear: Back,
            container: (capacity: Bulk(4)),
        ),
        "belt_pouch": (
            name: "a belt pouch",
            keywords: ["pouch", "belt"],
            description: "A small leather pouch that hangs from a belt.",
            bulk: Negligible,
            wear: Belt,
            container: (capacity: Light(4)),
        ),
        "keyring": (
            name: "a brass keyring",
            keywords: ["keyring", "ring", "brass"],
            description: "A plain brass ring that clips to a belt, made to hold keys.",
            bulk: Negligible,
            wear: Belt,
            container: (capacity: Count(10), accepts: ["key"]),
        ),
        "scroll_tube": (
            name: "a scroll tube",
            keywords: ["tube", "scroll"],
            description: "A capped leather tube for keeping scrolls dry and uncreased.",
            wear: Belt,
            container: (capacity: Count(4), accepts: ["scroll"]),
        ),
        "potion_pouch": (
            name: "a padded potion pouch",
            keywords: ["pouch", "potion", "padded"],
            description: "A padded pouch with loops that hold vials upright.",
            bulk: Negligible,
            wear: Belt,
            container: (capacity: Count(3), accepts: ["potion"]),
        ),
        "sword_sheath": (
            name: "a leather sheath",
            keywords: ["sheath", "scabbard", "leather"],
            description: "A plain leather sheath that hangs from a belt, sized for a single sword.",
            wear: Belt,
            container: (capacity: Count(1), accepts: ["blade"]),
        ),
        "weapon_loop": (
            name: "an iron weapon loop",
            keywords: ["loop", "iron", "weapon"],
            description: "A ring of iron on a leather tab, for hanging an axe, hammer or mace from a belt.",
            bulk: Negligible,
            wear: Belt,
            container: (capacity: Count(1), accepts: ["axe", "hammer", "mace"]),
        ),
        "hatchet": (
            name: "a woodsman's hatchet",
            keywords: ["hatchet", "axe", "woodsman"],
            description: "A short-hafted hatchet with a well-worn grip.",
            tags: ["axe"],
            weapon: (skill: "axes:basics", damage: (2, 4)),
        ),
        "travelers_coat": (
            name: "a traveller's coat",
            keywords: ["coat", "traveller"],
            description: "A long wool coat with deep pockets, worn soft at the cuffs.",
            wear: Body,
            container: (capacity: Count(2), max_item: Light),
        ),
        "oak_chest": (
            name: "an old oak chest",
            keywords: ["chest", "oak", "old"],
            description: "An iron-bound oak chest, far too heavy to carry off.",
            bulk: Bulk(8),
            fixed: true,
            container: (
                capacity: Bulk(10),
                state: Locked,
                lock: Some((key: Some("chest_key"), pick: Some(6), bash: Some(15))),
            ),
        ),
        "market_signpost": (
            name: "a weathered signpost",
            keywords: ["signpost", "sign", "post"],
            description: "Painted arrows point the way: Guild Row to the west, the North Gate to the north, the High Street and the keep to the south.",
            bulk: Bulk(4),
            fixed: true,
        ),
    },
    mobs: {
        "town_guard": (
            name: "a town guard",
            keywords: ["town", "guard", "watchman"],
            here: "A town guard keeps watch, one hand resting on the hilt of a short sword.",
            description: "A broad-shouldered watchman in a dented helm and a tabard faded from Riftwatch's colours to something closer to grey. They look bored, which is not the same as inattentive.",
            attributes: {Body: 6, Strength: 5, Agility: 4, Reaction: 4},
            skills: {"brawling:basics": 10, "athletics:dodge": 5},
        ),
        "stray_dog": (
            name: "a stray dog",
            keywords: ["stray", "dog", "mutt"],
            here: "A scruffy stray dog noses through the gutter for scraps.",
            description: "A lean, rangy mutt of no particular breed, with one torn ear and a hopeful tail. Every market stall-keeper knows it, and most of them pretend not to feed it.",
            attributes: {Body: 2, Strength: 2, Agility: 4, Reaction: 5},
            skills: {"beast:bite": 3},
            attack: "beast:bite",
            health: 6,
        ),
        "contract_clerk": (
            name: "the contract clerk",
            keywords: ["contract", "clerk"],
            here: "The contract clerk sits behind a desk heaped with ledgers, pen scratching.",
            description: "A thin, ink-stained clerk with spectacles pushed up into greying hair. They keep the guild's contracts, its ledgers and its members' tags, and they remember everyone who has ever failed to finish a job.",
        ),
        "herbalist": (
            name: "the herbalist",
            keywords: ["herbalist", "woman"],
            here: "The herbalist sorts dried leaves into bundles, muttering their names.",
            description: "A stooped woman with green-stained fingers and a sharp eye, who smells faintly of mint and something less pleasant underneath.",
        ),
        "drill_sergeant": (
            name: "the drill sergeant",
            keywords: ["drill", "sergeant"],
            here: "The drill sergeant paces the yard, barking at anyone who stands still.",
            description: "A grizzled veteran with a voice like a rockslide and a wooden practice sword that has broken more knuckles than any real blade.",
            attributes: {Body: 7, Strength: 6, Agility: 5, Reaction: 5},
            skills: {"brawling:basics": 20, "athletics:dodge": 10},
            teaches: [
                "swordplay:basics", "knives:basics", "axes:basics", "hammers:basics", "staves:basics",
                "athletics:toughness",
                "brawling:kick", "brawling:grapple", "swordplay:lunge", "swordplay:riposte",
                "knives:backstab", "knives:open_vein", "axes:cleave", "axes:hew",
                "hammers:stagger", "hammers:crush", "staves:sweep", "staves:guard",
            ],
        ),
        "shrine_keeper": (
            name: "the keeper of the shrine",
            keywords: ["keeper", "shrine", "priestess"],
            here: "The keeper of the shrine tends the candles, murmuring a prayer over each.",
            description: "A calm-faced woman in a faded grey habit, wax spattered across her sleeves. Her eyes rest on each visitor a moment longer than is comfortable, as if listening for something.",
            teaches: ["divine:foundation"],
        ),
        "magister": (
            name: "the magister",
            keywords: ["magister", "scholar", "mage"],
            here: "The magister sits at the reading desk, quill scratching beside a towering stack of books.",
            description: "An elderly scholar with ink-black fingertips and spectacles on a chain. The guild keeps him for his learning; he keeps the guild's grimoires, and teaches the rare few with the spark to read them.",
            teaches: ["hermetic:foundation"],
        ),
        "ascetic": (
            name: "an old ascetic",
            keywords: ["old", "ascetic", "monk"],
            here: "An old ascetic sits cross-legged at the parapet, breathing slowly, utterly still.",
            description: "Thin as a rake and brown as a nut, wearing little more than a loincloth despite the wind. The guards say he has sat here since before the barrier rose. His stillness has a weight to it, like a drawn bow.",
            teaches: ["adept:foundation", "adept:killing_hands", "adept:quickened_reflexes"],
        ),
    },
    spawns: {
        "shrine_keeper": (
            mob: "shrine_keeper",
            room: "shrine",
            every: Minutes(10),
            refill: Keep(1),
        ),
        "magister": (
            mob: "magister",
            room: "guild_archive",
            every: Minutes(10),
            refill: Keep(1),
        ),
        "ascetic": (
            mob: "ascetic",
            room: "watchtower",
            every: Minutes(10),
            refill: Keep(1),
        ),
        "market_signpost": (
            item: "market_signpost",
            room: "market",
            every: Hours(1),
            refill: Keep(1),
        ),
        "cellar_chest": (
            item: "oak_chest",
            contents: ["bread", "bread", "waterskin", "torch"],
            room: "guild_cellar",
            every: Hours(1),
            refill: Keep(1),
        ),
        "practice_swords": (
            item: "practice_sword",
            room: "training_yard",
            every: Minutes(30),
            refill: Keep(2),
        ),
        "archive_scroll": (
            item: "scroll",
            room: "guild_archive",
            every: Hours(2),
            refill: Keep(1),
        ),
        "gate_guards": (
            mob: "town_guard",
            room: "north_gate",
            every: Minutes(30),
            refill: Keep(2),
            wander: Zone(secs: (60, 180)),
        ),
        "market_dog": (
            mob: "stray_dog",
            room: "market",
            every: Hours(1),
            refill: Keep(1),
            wander: Rooms(rooms: ["market", "stalls", "back_alley", "tinkers_corner", "guild_row"], secs: (30, 90)),
        ),
        "contract_clerk": (
            mob: "contract_clerk",
            room: "contract_hall",
            every: Minutes(10),
            refill: Keep(1),
        ),
        "herbalist": (
            mob: "herbalist",
            room: "herbalist",
            every: Minutes(10),
            refill: Keep(1),
        ),
        "drill_sergeant": (
            mob: "drill_sergeant",
            room: "training_yard",
            every: Minutes(10),
            refill: Keep(1),
        ),
    },
    rooms: {
        "north_gate": (
            name: "North Gate",
            description: "The town wall breaks here around a squat stone gatehouse, its gates propped open for the day's traffic. Watchmen lean on their spears and study every traveller who comes in off the forest road.",
            exits: {
                "north": "forest:road",
                "south": "market",
                "east": "archery_butts",
                "down": (to: "sewers:north_trunk", door: "gate_grate"),
            },
        ),
        "archery_butts": (
            name: "Archery Butts",
            description: "A long strip of trampled grass runs along the inside of the wall, ending at straw targets stuffed into wooden frames. The targets bristle with broken shafts, and a rack of practice bows waits beneath a lean-to.",
            exits: {
                "west": "north_gate",
            },
        ),
        "market": (
            name: "Market Square",
            description: "Riftwatch's open-air market fills the square with awnings, carts and shouting. Hawkers call out prices over the clatter of wheels, and the smells of bread, tar and livestock mix in the air. Streets lead off in every direction.",
            exits: {
                "north": "north_gate",
                "south": "high_street",
                "east": "stalls",
                "west": "guild_row",
                "down": (to: "sewers:market_drain", door: "market_grate"),
            },
        ),
        "stalls": (
            name: "Vendor Stalls",
            description: "Rows of canvas-roofed stalls crowd the east side of the square, selling everything from boot leather to bolts of dyed wool. Merchants watch their goods with one eye and the crowd with the other.",
            exits: {
                "west": "market",
                "east": "tinkers_corner",
                "north": "herbalist",
                "south": "back_alley",
                "down": (to: "sewers:stalls_culvert", door: "stalls_grate"),
            },
        ),
        "herbalist": (
            name: "Herbalist's Stall",
            description: "Bundles of drying herbs hang thick from the poles of this cramped stall, and shelves of stoppered jars line its back wall. The air is green and bitter with crushed leaves.",
            no_wander: true,
            exits: {
                "south": "stalls",
            },
        ),
        "tinkers_corner": (
            name: "Tinkers' Corner",
            description: "Tinkers and menders have claimed this corner of the market, their benches cluttered with pots, locks, lanterns and half-mended tools. Something is always being hammered back into shape.",
            exits: {
                "west": "stalls",
            },
        ),
        "back_alley": (
            name: "Back Alley",
            description: "A narrow alley behind the stalls, cluttered with broken crates and the market's refuse. A rusted grate in the cobbles drains into the dark below, and the place smells like it.",
            exits: {
                "north": "stalls",
                "down": (to: "sewers:outfall", door: "sewer_grate"),
            },
        ),
        "guild_row": (
            name: "Guild Row",
            description: "A broad street of timber-framed halls runs west from the market. The largest bears a painted sign of a sword crossed over a lantern: the Adventurers' Guild.",
            exits: {
                "east": "market",
                "north": (to: "guildhall", door: "guild_doors"),
                "down": (to: "sewers:guild_tunnel", door: "guild_grate"),
            },
        ),
        "guildhall": (
            name: "Adventurers' Guildhall",
            description: "A long common hall with a roaring hearth, scarred tables and a crowd of adventurers trading stories and lies. Trophies from beyond the walls hang from the rafters, some of them still unsettling to look at.",
            indoors: true,
            exits: {
                "south": (to: "guild_row", door: "guild_doors"),
                "west": "contract_hall",
                "east": "guild_archive",
                "up": "guild_quarters",
                "down": "guild_cellar",
            },
        ),
        "guild_cellar": (
            name: "Guild Cellar",
            description: "A low stone cellar crowded with barrels, sacks and crates of the guild's stores. In the far corner an iron hatch is set into the floor, padlocked and smelling faintly of the sewers.",
            indoors: true,
            exits: {
                "up": "guildhall",
                "down": (to: "sewers:guild_drain", door: "guild_hatch"),
            },
        ),
        "contract_hall": (
            name: "Contract Hall",
            description: "A quieter room where the guild's work is posted. A great board is layered with contracts, bounties and warnings, the older ones curling at the edges beneath the newer.",
            indoors: true,
            no_wander: true,
            exits: {
                "east": "guildhall",
            },
        ),
        "guild_archive": (
            name: "Guild Archive",
            description: "Shelves of ledgers, maps and battered books fill this cramped room, the guild's long memory of what lies beyond the walls. A reading desk sits beneath the only window, and a locked case holds the volumes the guild guards most closely.",
            indoors: true,
            no_wander: true,
            exits: {
                "west": "guildhall",
            },
        ),
        "guild_quarters": (
            name: "Guild Quarters",
            description: "A narrow upstairs corridor lined with plain sleeping rooms, rented by the night to members between contracts.",
            indoors: true,
            no_wander: true,
            exits: {
                "down": "guildhall",
            },
        ),
        "high_street": (
            name: "High Street",
            description: "The town's main street climbs gently south from the market toward the walls of the keep. Wealthier houses stand here, and the garrison's banners hang over a gateway to the east.",
            exits: {
                "north": "market",
                "south": "keep_gate",
                "east": "garrison_yard",
                "west": "shrine",
                "down": (to: "sewers:great_drain", door: "high_street_grate"),
            },
        ),
        "shrine": (
            name: "Wayside Shrine",
            description: "A small stone shrine set back from the street, lit by guttering candles and heaped with offerings. Travellers stop here to give thanks for safe roads, or to ask for them.",
            indoors: true,
            no_wander: true,
            exits: {
                "east": "high_street",
            },
        ),
        "garrison_yard": (
            name: "Garrison Yard",
            description: "A packed-earth yard enclosed by the garrison's barracks and storehouses. Soldiers drill in ranks while a sergeant bellows the count.",
            exits: {
                "west": "high_street",
                "north": "barracks",
                "south": "training_yard",
                "east": (to: "armory", door: "armory_door"),
                "down": (to: "sewers:garrison_drain", door: "garrison_grate"),
            },
        ),
        "training_yard": (
            name: "Training Yard",
            description: "Battered wooden posts and straw-stuffed dummies stand in rows across this practice ground, hacked nearly to splinters. Racks of blunted weapons line the walls, and the sand of the sparring circle is churned with footprints.",
            exits: {
                "north": "garrison_yard",
            },
        ),
        "barracks": (
            name: "Barracks",
            description: "Rows of narrow bunks and footlockers, smelling of sweat, oil and woodsmoke. Off-duty soldiers dice and doze between watches.",
            indoors: true,
            exits: {
                "south": "garrison_yard",
            },
        ),
        "armory": (
            name: "Armory",
            description: "Racks of spears, crossbows and shields stand in careful order, each one tallied in the quartermaster's ledger.",
            indoors: true,
            exits: {
                "west": (to: "garrison_yard", door: "armory_door"),
            },
        ),
        "keep_gate": (
            name: "Keep Gatehouse",
            description: "A thick-walled gatehouse guards the way into the lord's keep, its gates studded with iron. Guards in the lord's colours stand watch beneath the arch.",
            exits: {
                "north": "high_street",
                "south": (to: "keep_courtyard", door: "keep_gates"),
            },
        ),
        "keep_courtyard": (
            name: "Keep Courtyard",
            description: "A cobbled courtyard inside the keep's walls, busy with servants, horses and messengers. Steps climb to the battlements and the watchtower above.",
            exits: {
                "north": (to: "keep_gate", door: "keep_gates"),
                "south": "great_hall",
                "up": "watchtower",
                "down": "keep_dungeon",
            },
        ),
        "keep_dungeon": (
            name: "Keep Dungeon",
            description: "A row of damp cells beneath the keep, most of them empty, their doors hanging open. Water seeps down the walls, and a stout iron door at the end of the passage leads deeper still.",
            indoors: true,
            exits: {
                "up": "keep_courtyard",
                "down": (to: "sewers:sluice", door: "dungeon_door"),
            },
        ),
        "watchtower": (
            name: "Watchtower",
            description: "From the top of the keep's tallest tower the whole of Riftwatch spreads out below, and beyond the walls the land runs on to the horizon, where the faint shimmer of the barrier hangs in the air.",
            exits: {
                "down": "keep_courtyard",
            },
        ),
        "great_hall": (
            name: "Great Hall",
            description: "The lord's great hall, hung with faded tapestries and lit by high windows. A long table runs beneath a raised dais where the lord holds court and hears petitions.",
