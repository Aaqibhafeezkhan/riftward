    finds: {
        Forest: {
            "forage": [("wild_berries", 40), ("mushrooms", 30), ("hazelnuts", 15), ("wild_garlic", 15)],
            "herbs": [("yarrow", 50), ("kingsfoil", 35), ("moonpetal", 15)],
        },
        Field: {
            "forage": [("wild_berries", 50), ("sorrel", 50)],
            "herbs": [("yarrow", 40), ("kingsfoil", 30), ("chamomile", 30)],
        },
        Water: {
            "forage": [("watercress", 1)],
            "herbs": [("kingsfoil", 60), ("moonpetal", 40)],
        },
    },
    rooms: {
        "woodcutters_track": (
            name: "Woodcutters' Track",
            description: "A rutted track leaves the road and runs west between stands of young trees. Stumps line it, grey and old, where the woodcutters cleared a way for their carts years ago. Sunlight gets in here, and the undergrowth is thick and green.",
            terrain: Uneven,
            exits: {
                "east": "bend",
                "west": "old_track",
                "south": "birch_wood",
            },
            environment: Forest,
        ),
        "old_track": (
            name: "Old Track",
            description: "The track grows fainter here, the ruts filled with moss and last year's leaves. A path runs north to a clearing of stumps, another south into hazel, and the smell of old woodsmoke drifts from the west.",
            terrain: Uneven,
            exits: {
                "east": "woodcutters_track",
                "west": "charcoal_camp",
                "north": "stump_field",
                "south": "hazel_copse",
            },
            environment: Forest,
        ),
        "stump_field": (
            name: "Stump Field",
            description: "A wide clearing of stumps, cut low and left to rot, with brambles and foxgloves grown up between them. Rabbit runs criss-cross the grass. At its edge the trees stand close again, darker and older.",
            terrain: Uneven,
            exits: {
                "south": "old_track",
            },
            environment: Field,
        ),
        "charcoal_camp": (
            name: "Charcoal Burners' Camp",
            description: "Three turf-covered kilns, long cold, sit in a ring of trampled earth blackened by years of charcoal. A lean-to of poles and hides has been built against the largest, and frames of stretched skins stand drying in the sun. Someone lives here again.",
            terrain: Uneven,
            exits: {
                "east": "old_track",
            },
            environment: Forest,
        ),
        "birch_wood": (
            name: "Birch Wood",
            description: "Slender white birches stand close together, their bark peeling in papery curls. The light comes through green and moving. The ground is soft with leaf mould, and full of small tracks.",
            terrain: Uneven,
            exits: {
                "north": "woodcutters_track",
                "west": "hazel_copse",
                "south": "deer_meadow",
            },
            environment: Forest,
        ),
        "hazel_copse": (
            name: "Hazel Copse",
            description: "Old hazels have grown into a thicket of springy stems, coppiced long ago and left. Nutshells litter the ground, split by squirrels and worse. The way south grows wilder, and something has rooted up the earth here.",
            terrain: Uneven,
            exits: {
                "north": "old_track",
                "east": "birch_wood",
                "south": "meadow_edge",
            },
            environment: Forest,
        ),
        "meadow_edge": (
            name: "Meadow's Edge",
            description: "The trees give out onto open grass, and the sky is suddenly very big. The meadow rolls away to the east, starred with flowers. Southward, a dark wall of brambles.",
            terrain: Uneven,
            exits: {
                "north": "hazel_copse",
                "east": "deer_meadow",
                "south": "bramble_thicket",
            },
            environment: Field,
        ),
        "deer_meadow": (
            name: "Deer Meadow",
            description: "A long meadow of tall grass and clover, ringed by trees, where the deer come to graze at dawn and dusk. The grass is flattened in places where they've lain. Water chatters somewhere to the south.",
            terrain: Uneven,
            exits: {
                "north": "birch_wood",
                "west": "meadow_edge",
                "east": "high_meadow",
                "south": "brook_ford",
            },
            environment: Field,
            chatter: ["Birdsong drifts across the meadow.", "The long grass hisses in the wind."],
        ),
        "high_meadow": (
            name: "High Meadow",
            description: "The meadow climbs to a sunny rise of rough grass and warm, flat stones. From up here you can see the dark line of the deep wood to the north, and the road beyond the trees. The stones are good for basking, and not only for you.",
            terrain: Uneven,
            exits: {
                "west": "deer_meadow",
            },
            environment: Field,
        ),
        "brook_ford": (
            name: "Brook Ford",
            description: "A clear brook runs wide and shallow over gravel here, and the bank is churned to mud by hooves and paws: every creature in the woods comes here to drink. Watercress grows thick at the edges. Downstream, the water deepens into reeds.",
            terrain: Mud,
            exits: {
                "north": "deer_meadow",
                "west": "bramble_thicket",
                "east": "brook_bank",
                "south": "reed_pool",
            },
            environment: Water,
        ),
        "brook_bank": (
            name: "Brook Bank",
            description: "The brook runs deeper here, under overhanging alders, its banks steep and undercut. Roots trail in the water. A path follows the bank south, worn by something low and heavy.",
            terrain: Uneven,
            exits: {
                "west": "brook_ford",
                "south": "sett_bank",
            },
            environment: Forest,
        ),
        "bramble_thicket": (
            name: "Bramble Thicket",
            description: "Brambles grow higher than your head, a tangle of thorny arches you have to push and duck through. Tufts of coarse dark hair hang on the thorns, and the ground is trampled into narrow runs.",
            conditions: [(condition: "brambles", strength: 1)],
            terrain: Rough,
            exits: {
                "north": "meadow_edge",
                "east": "brook_ford",
                "south": "boar_wallow",
            },
            environment: Forest,
        ),
        "boar_wallow": (
            name: "Boar Wallow",
            description: "A hollow in the trees has been churned into a stinking wallow of black mud. The trunks around it are rubbed bare and smeared with mud to the height of your waist. Something big lives here.",
            terrain: Mud,
            exits: {
                "north": "bramble_thicket",
                "east": "reed_pool",
            },
            environment: Forest,
        ),
        "reed_pool": (
            name: "Reed Pool",
            description: "The brook spreads into a still, brown pool, choked with reeds and lily pads. Things plop into the water as you come near. The mud at the edge sucks at your feet.",
            terrain: Wading,
            exits: {
                "north": "brook_ford",
                "west": "boar_wallow",
                "east": "sett_bank",
            },
            environment: Water,
        ),
        "sett_bank": (
            name: "Sett Bank",
            description: "A steep, sandy bank under old oaks, riddled with holes: a badger sett, generations old. Mounds of fresh-dug earth and old bedding spill from the entrances. Beyond, the trees close in, dark and old.",
            terrain: Uneven,
            exits: {
                "north": "brook_bank",
                "west": "reed_pool",
            },
            environment: Forest,
        ),
        "clearing": (
            name: "Hermit's Clearing",
            description: "The trees draw back around a ring of standing stones, each daubed with faded ochre spirals. A low hut of woven branches leans against the largest stone, and a thin thread of smoke rises from a fire that never quite goes out. North, past the stones, the trees grow older and closer, and the light goes out of the wood.",
            terrain: Uneven,
            exits: {
                "south": "north_road",
                "north": "old_wood_edge",
            },
            environment: Forest,
        ),
        "bend": (
            name: "The Bend",
            description: "The road continues along until it reaches a fork.",
            terrain: Road,
            exits: {
                "east": "east_road",
                "north": "north_road",
                "south": "road",
                "west": "woodcutters_track",
            },
            environment: Forest,
        ),
        "east_road": (
            name: "East Road",
            description: "The road runs along the lip of a steep ravine. Below, through a tangle of roots and ferns, something pale glimmers among the rocks. The way down is a hard climb.",
            terrain: Road,
            exits: {
                "down": (to: "ravine", needs: Climb(4)),
                "west": "bend",
            },
            environment: Forest,
        ),
        "ravine": (
            name: "Ravine Floor",
            description: "Moss-slick boulders crowd the bottom of the ravine, where little light reaches. Pale moonpetal grows thick in the damp between the stones, untouched by anyone unwilling to make the climb. A stream threads between the rocks, north toward a far-off roar and south toward quieter water, and a cleft full of ferns opens to the west.",
            terrain: Rough,
            exits: {
                "up": (to: "east_road", needs: Climb(4)),
                "north": "ravine_narrows",
                "south": "stony_shallows",
                "west": "fern_gully",
            },
            environment: Forest,
            finds: {
                "forage": [("wild_berries", 70), ("mushrooms", 30)],
                "herbs": [("kingsfoil", 40), ("moonpetal", 60)],
            },
        ),
        "north_road": (
            name: "North Road",
            description: "The road narrows to a deer track between dark, crowding trees. Somewhere ahead, a thread of woodsmoke hangs in the still air.",
            terrain: Uneven,
            exits: {
                "north": "clearing",
                "south": "bend",
            },
            environment: Forest,
        ),
        "road": (
            name: "Forest Road",
            description: "Twisted trees crowd the path. Something rustles in the undergrowth.",
            terrain: Road,
            exits: {
                "north": "bend",
                "south": "riftwatch:north_gate",
            },
            environment: Forest,
        ),
        "ravine_narrows": (
            name: "The Narrows",
            description: "The ravine pinches in until the walls almost meet overhead, close enough to touch both at once. The stream fills the whole floor here, loud and fast over a bed of round stones, and the air is thick with spray. Upstream, a deep roar grows.",
            chatter: ["Stones knock together in the current.", "Spray drifts down from somewhere above."],
            terrain: Rough,
            exits: {
                "south": "ravine",
                "north": "mossy_falls",
            },
            environment: Forest,
        ),
        "mossy_falls": (
            name: "Mossy Falls",
            description: "A waterfall drops out of the rock in a white curtain and crashes into a round green pool, deep and cold. Every stone around it wears a thick coat of moss, and ferns hang from the cliff in the spray. Behind the falling water, the rock is dark: there might be a way through, for someone willing to swim under it.",
            chatter: ["The falls roar on and on.", "A kingfisher flashes blue across the pool and is gone."],
            terrain: Wading,
            exits: {
                "south": "ravine_narrows",
                "north": (to: "falls_ledge", needs: Swim(4)),
            },
            environment: Water,
        ),
        "falls_ledge": (
            name: "Behind the Falls",
            description: "A ledge of wet rock runs behind the waterfall, the light coming through the water green and moving. The noise is enormous. Everything here drips, and in the cold spray grow things that grow nowhere else: pale moonpetal, and ferns whose fronds are rimed white like frost.",
            terrain: Rough,
            exits: {
                "south": (to: "mossy_falls", needs: Swim(4)),
            },
            environment: Water,
            finds: {
                "herbs": [("moonpetal", 60), ("frostfern", 40)],
            },
        ),
        "fern_gully": (
            name: "Fern Gully",
            description: "A side cleft opens off the ravine, choked with ferns taller than a man. The ground underneath is black and soft with years of leaf mould, and mushrooms push up through it in rings and clusters wherever you look.",
            terrain: Uneven,
            exits: {
                "east": "ravine",
            },
            environment: Forest,
            finds: {
                "forage": [("wild_berries", 20), ("mushrooms", 80)],
                "herbs": [("yarrow", 40), ("kingsfoil", 40), ("moonpetal", 20)],
            },
        ),
        "stony_shallows": (
            name: "Stony Shallows",
            description: "Below the boulders, the stream spreads out wide and shallow over a bed of flat grey stones, clear enough to count them. It's ankle-deep for the most part, deeper in the channel along the far side, where something large sits half out of the water.",
            chatter: ["The stream chuckles over the stones."],
            terrain: Uneven,
            exits: {
                "north": "ravine",
                "south": "otter_pool",
            },
            environment: Water,
        ),
        "otter_pool": (
            name: "Otter Pool",
            description: "The stream slows and deepens into a long pool under leaning alders, dark and still. Its banks are worn smooth in places, slides down to the water where something has gone in again and again. Fish rise to the surface in widening rings.",
            terrain: Uneven,
            exits: {
                "north": "stony_shallows",
                "east": "alder_bank",
            },
            environment: Water,
        ),
        "alder_bank": (
            name: "Alder Bank",
            description: "The ravine widens at last into a flat of soft ground under a stand of alders, their roots knotted along the water's edge. The walls here are lower and broken, but still too steep to climb. It's quiet, and the stream goes on past into the rocks, where no one can follow.",
            terrain: Mud,
            exits: {
                "west": "otter_pool",
            },
            environment: Forest,
        ),
        "old_wood_edge": (
            name: "Edge of the Old Wood",
            description: "Past the clearing the trees change. These are old: oaks and beeches so broad that three people couldn't reach around them, their roots humped over the ground like the backs of sleeping animals. The canopy closes overhead, and the light goes green, then grey, then almost nothing.",
            chatter: ["Something moves in the dark between the trees, and is still."],
            light: Dark,
            tangled: 1,
            terrain: Rough,
            exits: {
                "south": "clearing",
                "north": "fallen_giant",
                "west": "toadstool_ring",
                "east": "bee_tree",
            },
            environment: Forest,
        ),
        "fallen_giant": (
            name: "The Fallen Giant",
            description: "An oak of impossible size has come down here, years ago, and lies across the forest floor like a wall, taller than a man even on its side. Ferns and saplings grow along its back. A dark hollow runs into its broken trunk. It's the one thing in the old wood you could find again.",
            light: Dark,
            terrain: Rough,
            exits: {
                "south": "old_wood_edge",
                "north": "darkling_path",
                "east": "black_stream",
            },
            environment: Forest,
        ),
        "bee_tree": (
            name: "The Bee Tree",
            description: "A dead beech stands in a gap in the canopy, grey and barkless, and halfway up its trunk a hollow drones like a forge. Bees come and go from it in a thin stream. Wax and old honey have run down the wood below the hole and dried in amber streaks.",
            chatter: ["The bees drone on and on in the hollow tree."],
            conditions: [(condition: "angry_bees", strength: 1)],
            terrain: Rough,
            exits: {
                "west": "old_wood_edge",
            },
            environment: Forest,
            finds: {
                "forage": [("wild_berries", 30), ("honeycomb", 70)],
            },
        ),
        "toadstool_ring": (
            name: "Toadstool Ring",
            description: "Mushrooms grow in a wide ring here, white and brown and pale yellow, around a patch of bare black earth where nothing else will grow. The air smells of damp and rot. Some of them look good to eat. Some of them look exactly like the ones that do.",
            light: Dark,
            tangled: 2,
            terrain: Uneven,
            exits: {
                "east": "old_wood_edge",
                "north": "nightshade_dell",
            },
            environment: Forest,
            finds: {
                "forage": [("deathcap", 40), ("mushrooms", 60)],
            },
        ),
        "nightshade_dell": (
            name: "Nightshade Dell",
            description: "The ground drops into a dell where the air is still and close. Foxglove stands in purple spikes along its sides, and in the shade at the bottom, low bushes hang with glossy black berries. Nothing here wants to be eaten.",
            light: Dark,
            tangled: 2,
            terrain: Uneven,
            exits: {
                "south": "toadstool_ring",
                "east": "darkling_path",
            },
            environment: Forest,
            finds: {
                "herbs": [("foxglove", 50), ("nightshade", 50)],
            },
        ),
        "darkling_path": (
            name: "Darkling Path",
            description: "A narrow path, more a habit of the trees than a trail, winds north between trunks furred with moss. It's been trodden by something, often, and recently: the leaf litter is pressed flat, and the smell is rank and animal.",
            light: Dark,
            tangled: 2,
            terrain: Uneven,
            exits: {
                "south": "fallen_giant",
                "west": "nightshade_dell",
                "north": "web_thicket",
            },
            environment: Forest,
        ),
        "web_thicket": (
            name: "Web-Hung Thicket",
            description: "The undergrowth thickens into a tangle of holly and hawthorn, and grey threads start to show between the branches: a few at first, then sheets of them, sagging with dew and old leaves. Small wrapped shapes hang in some of them. The way on to the north is darker still.",
            light: Dark,
            tangled: 2,
            terrain: Rough,
            exits: {
                "south": "darkling_path",
                "north": "spider_hollow",
            },
            environment: Forest,
        ),
        "spider_hollow": (
            name: "Spider Hollow",
            description: "A hollow among the roots of three great trees, roofed over with web so thick it blots out what little light there is. The ground is littered with small bones and husks. Strands drift against your face with every step, and something, somewhere above, shifts its weight.",
            conditions: [(condition: "webs", strength: 1)],
            light: Dark,
            tangled: 1,
            terrain: Rough,
            exits: {
                "south": "web_thicket",
            },
            environment: Forest,
        ),
        "black_stream": (
            name: "Black Stream",
            description: "A stream runs out of the deep wood here, black over black stones, between banks of roots and moss. It's the one sure way through the old wood: follow it north and it leads further in; follow it back and it brings you out by the Fallen Giant.",
            chatter: ["The black stream mutters over the roots."],
            light: Dark,
            tangled: 1,
            terrain: Uneven,
            exits: {
                "west": "fallen_giant",
                "north": "stream_bend",
            },
            environment: Water,
        ),
        "stream_bend": (
            name: "Stream Bend",
            description: "The stream bends around a shelf of rock, and the trees beyond are older and closer still. Claw marks score the bark of a beech at head height. North, past where the stream goes, the wood grows deeper than anyone in Riftwatch will talk about.",
            light: Dark,
            terrain: Rough,
            exits: {
                "south": "black_stream",
                "north": "old_wood_deep",
            },
            environment: Forest,
        ),
        "old_wood_deep": (
            name: "The Old Wood",
            description: "This is the heart of the Darkwood. The trees here were old when Riftwatch was built, and they stand so close and so tall that it might always be night. Nothing grows beneath them but moss. Far off, a tree creaks like a door opening, and then is quiet.",
            chatter: ["Somewhere far off, a tree creaks like a door.", "A long way away, a wolf howls."],
            light: Dark,
            tangled: 2,
            terrain: Rough,
            exits: {
                "south": "stream_bend",
                "north": "wolf_run",
                "east": "ironbark_grove",
                "west": "moss_hollow",
            },
            environment: Forest,
        ),
        "wolf_run": (
            name: "Wolf Run",
            description: "A broad, beaten trail runs north through the trees, trodden bare by many feet, all of them with claws. The bark of every trunk along it is scored and rubbed. Grey hair hangs on the low branches.",
            light: Dark,
            tangled: 1,
            terrain: Uneven,
            exits: {
                "south": "old_wood_deep",
                "north": "bone_glade",
                "west": "howling_rocks",
            },
            environment: Forest,
        ),
        "howling_rocks": (
            name: "Howling Rocks",
            description: "A knuckle of grey rock pushes up out of the forest floor, bare and cold, and the trees stand back from it. From its top you could see over the lower branches, if there were anything to see. The stone is worn smooth in places, where things have sat a long time, and called.",
            chatter: ["The wind moans over the bare rock."],
            light: Dark,
            tangled: 1,
            terrain: Rough,
            exits: {
                "east": "wolf_run",
            },
            environment: Forest,
        ),
        "bone_glade": (
            name: "Bone Glade",
            description: "The run opens into a small glade carpeted with bones: deer, mostly, and boar, and some you'd rather not look at closely. They lie where they were dropped, gnawed and cracked. The smell is thick. North, a dark opening shows under a ledge of rock.",
            light: Dark,
            tangled: 2,
            terrain: Uneven,
            exits: {
                "south": "wolf_run",
                "north": "den_mouth",
            },
            environment: Forest,
        ),
        "den_mouth": (
            name: "Den Mouth",
            description: "A ledge of rock juts out of a bank of earth, and under it a hole runs back into the dark, wide enough to crawl into. The ground in front is packed hard and strewn with tufts of grey fur. Low growls, or breathing, come from inside.",
            light: Dark,
            tangled: 1,
            terrain: Uneven,
            exits: {
                "south": "bone_glade",
                "north": "wolf_den",
            },
            environment: Forest,
        ),
        "wolf_den": (
            name: "The Wolf Den",
            description: "A low cave runs back under the bank, its floor dug out smooth and lined with old fur and leaves. It's warm, and close, and it stinks of wolf. Eyes catch the light at the back, more of them than you'd like.",
            light: Dark,
            terrain: Uneven,
            exits: {
                "south": "den_mouth",
            },
            environment: Cave,
        ),
        "moss_hollow": (
            name: "Moss Hollow",
            description: "The ground dips into a hollow where moss lies so deep over everything that it swallows sound: fallen trunks, stones, the roots of the old trees, all of it a soft green-black lump under your feet. It's very quiet. It's the kind of quiet that makes you listen.",
            light: Dark,
            tangled: 3,
            terrain: Uneven,
            exits: {
                "east": "old_wood_deep",
                "north": "thorn_tangle",
            },
            environment: Forest,
        ),
        "thorn_tangle": (
            name: "Thorn Tangle",
            description: "Blackthorn has grown up here in a dense, spiked wall, and the only way through is a gap something large has smashed in it. The thorns are as long as your thumb. West, beyond the tangle, the ground rises in a slope of loose grey stone.",
            conditions: [(condition: "brambles", strength: 2)],
            light: Dark,
            tangled: 3,
            terrain: Rough,
            exits: {
                "south": "moss_hollow",
                "west": "scree_slope",
            },
            environment: Forest,
        ),
        "scree_slope": (
            name: "Scree Slope",
            description: "A slope of loose grey stone climbs out of the trees toward a cliff face, and every step slides. Halfway up, a dark cave mouth opens in the rock. Big tracks go up the scree to it, and the stones around the entrance are scratched white.",
            light: Dark,
            tangled: 1,
            terrain: Rough,
            exits: {
                "east": "thorn_tangle",
                "north": "cave_mouth",
            },
            environment: Forest,
        ),
        "cave_mouth": (
            name: "Cave Mouth",
            description: "The cave mouth is tall and wide, and the air coming out of it is warm and smells of musk. Bones are scattered over the ledge in front, and a heap of dead bracken has been dragged inside. Something very large sleeps in there.",
            light: Dark,
            terrain: Rough,
            exits: {
                "south": "scree_slope",
                "north": "bear_cave",
            },
            environment: Cave,
        ),
        "bear_cave": (
            name: "The Bear's Cave",
            description: "The cave runs back into the hill, its floor scooped out and lined with bracken and moss. Claw marks score the walls higher than you could reach. It's the bear's, and everything in here says so.",
            light: Dark,
            terrain: Rough,
            exits: {
                "south": "cave_mouth",
            },
            environment: Cave,
        ),
        "ironbark_grove": (
            name: "Ironbark Grove",
            description: "The old oaks give way to a grove of strange trees with black, ridged bark as hard as iron, that rings when you knock on it. Their leaves are small and dark and never seem to fall. Past them, the ground climbs east toward a hill, and something on the hilltop catches what little light there is.",
            light: Dark,
            tangled: 2,
            terrain: Rough,
            exits: {
                "west": "old_wood_deep",
            },
            environment: Forest,
        ),
    },
)
