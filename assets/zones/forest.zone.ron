        "heron": (
            name: "a grey heron",
            keywords: ["heron", "grey", "bird"],
            here: "A grey heron stands motionless in the shallows.",
            description: "A tall grey bird on long legs, its neck folded and its dagger of a bill pointed at the water. It hasn't moved in a long while, and it doesn't intend to for you.",
            attributes: {Body: 1, Strength: 1, Agility: 4, Reaction: 5},
            skills: {"beast:peck": 1},
            attack: "beast:peck",
            health: 4,
            traits: ["skittish"],
            chatter: ["The heron's bill flashes into the water and comes up with something silver."],
        ),
        "forest_spider": (
            name: "a forest spider",
            tags: ["spider"],
            keywords: ["spider", "forest"],
            here: "A forest spider crouches in its web, legs drawn in.",
            description: "A spider the size of a large dog, mottled brown and black like bark, with a cluster of wet black eyes and fangs that glisten. It is perfectly still, until it isn't.",
            attributes: {Body: 3, Strength: 3, Agility: 6, Reaction: 6},
            skills: {"beast:fangs": 6},
            attack: "beast:fangs",
            health: 12,
            aggressive: Always,
            allies: ["spider"],
            conditions: [(condition: "hidden", strength: 8)],
            traits: ["night_eyes", "venomous"],
            harvest: {"hide": [("spider_silk", 1)], "meat": [(None, 40), ("venom_sac", 60)]},
        ),
        "grey_wolf": (
            name: "a grey wolf",
            tags: ["wolf"],
            keywords: ["wolf", "grey"],
            here: "A grey wolf lopes between the trees, head low.",
            description: "A lean grey wolf, taller at the shoulder than any dog in Riftwatch, with pale eyes that never leave you. Its ribs show. It's hungry.",
            attributes: {Body: 4, Strength: 4, Agility: 5, Reaction: 5},
            skills: {"beast:wolf_bite": 7, "beast:howl": 1, "beast:pull_down": 5},
            attack: "beast:wolf_bite",
            health: 16,
            aggressive: Always,
            allies: ["wolf"],
            traits: ["night_eyes", "pack_hunter"],
            harvest: {"hide": [("wolf_pelt", 1)], "meat": [(None, 30), ("wolf_fang", 70)]},
            chatter: ["A wolf howls somewhere in the dark, and another answers.", "The wolf lifts its head and tests the air."],
        ),
        "old_she_wolf": (
            name: "the old she-wolf",
            tags: ["wolf"],
            keywords: ["wolf", "she-wolf", "old", "grey"],
            here: "The old she-wolf lies at the back of the den, watching you with yellow eyes.",
            description: "A huge, grizzled wolf, silver at the muzzle, with a torn ear and a scar across her shoulders where something once nearly had her. She doesn't get up when you come in. She doesn't need to.",
            attributes: {Body: 7, Strength: 7, Agility: 6, Reaction: 7},
            skills: {"beast:wolf_bite": 14, "beast:howl": 1, "beast:pull_down": 10, "beast:old_she_wolfs_lead": 1},
            attack: "beast:wolf_bite",
            health: 45,
            aggressive: Always,
            boss: true,
            allies: ["wolf"],
            traits: ["night_eyes", "pack_hunter"],
            harvest: {"hide": [("great_wolf_pelt", 1)], "meat": [("wolf_fang", 1)]},
        ),
        "brown_bear": (
            name: "a brown bear",
            tags: ["bear"],
            keywords: ["bear", "brown"],
            here: "A brown bear sprawls in the dark at the back of the cave.",
            description: "A brown bear the size of a cart, humped at the shoulder, with a broad, scarred face and small dark eyes. It smells of musk and old meat. This is its home, and it knows you're in it.",
            attributes: {Body: 9, Strength: 9, Agility: 3, Reaction: 4},
            skills: {"beast:maul": 14},
            attack: "beast:maul",
            health: 60,
            aggressive: Home,
            traits: ["night_eyes", "thick_hide"],
            harvest: {"hide": [("bear_pelt", 1)], "meat": [("bear_meat", 70), ("bear_claw", 30)]},
            chatter: ["The bear huffs, a deep sound you feel in your chest."],
        ),
    },
