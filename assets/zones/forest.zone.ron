    rooms: {
        "woodcutters_track": (
            name: "Woodcutters' Track",
            description: "A rutted track leaves the road and runs west between stands of young trees. Stumps line it, grey and old, where the woodcutters cleared a way for their carts years ago. Sunlight gets in here, and the undergrowth is thick and green.",
            terrain: Uneven,
            exits: {
                "east": "bend",
                "west": "old_track",
                "south": "birch_wood",
            },
            environment: Forest,
        ),
        "old_track": (
            name: "Old Track",
            description: "The track grows fainter here, the ruts filled with moss and last year's leaves. A path runs north to a clearing of stumps, another south into hazel, and the smell of old woodsmoke drifts from the west.",
            terrain: Uneven,
            exits: {
                "east": "woodcutters_track",
                "west": "charcoal_camp",
                "north": "stump_field",
                "south": "hazel_copse",
            },
            environment: Forest,
        ),
        "stump_field": (
            name: "Stump Field",
            description: "A wide clearing of stumps, cut low and left to rot, with brambles and foxgloves grown up between them. Rabbit runs criss-cross the grass. At its edge the trees stand close again, darker and older.",
            terrain: Uneven,
            exits: {
                "south": "old_track",
            },
            environment: Field,
        ),
        "charcoal_camp": (
            name: "Charcoal Burners' Camp",
            description: "Three turf-covered kilns, long cold, sit in a ring of trampled earth blackened by years of charcoal. A lean-to of poles and hides has been built against the largest, and frames of stretched skins stand drying in the sun. Someone lives here again.",
            terrain: Uneven,
            exits: {
                "east": "old_track",
            },
            environment: Forest,
        ),
        "birch_wood": (
            name: "Birch Wood",
            description: "Slender white birches stand close together, their bark peeling in papery curls. The light comes through green and moving. The ground is soft with leaf mould, and full of small tracks.",
            terrain: Uneven,
            exits: {
                "north": "woodcutters_track",
                "west": "hazel_copse",
                "south": "deer_meadow",
            },
            environment: Forest,
        ),
        "hazel_copse": (
            name: "Hazel Copse",
            description: "Old hazels have grown into a thicket of springy stems, coppiced long ago and left. Nutshells litter the ground, split by squirrels and worse. The way south grows wilder, and something has rooted up the earth here.",
            terrain: Uneven,
            exits: {
                "north": "old_track",
                "east": "birch_wood",
                "south": "meadow_edge",
            },
            environment: Forest,
        ),
        "meadow_edge": (
            name: "Meadow's Edge",
            description: "The trees give out onto open grass, and the sky is suddenly very big. The meadow rolls away to the east, starred with flowers. Southward, a dark wall of brambles.",
            terrain: Uneven,
            exits: {
                "north": "hazel_copse",
                "east": "deer_meadow",
                "south": "bramble_thicket",
            },
            environment: Field,
        ),
        "deer_meadow": (
            name: "Deer Meadow",
            description: "A long meadow of tall grass and clover, ringed by trees, where the deer come to graze at dawn and dusk. The grass is flattened in places where they've lain. Water chatters somewhere to the south.",
            terrain: Uneven,
            exits: {
                "north": "birch_wood",
                "west": "meadow_edge",
                "east": "high_meadow",
                "south": "brook_ford",
            },
            environment: Field,
        ),
        "high_meadow": (
            name: "High Meadow",
            description: "The meadow climbs to a sunny rise of rough grass and warm, flat stones. From up here you can see the dark line of the deep wood to the north, and the road beyond the trees. The stones are good for basking, and not only for you.",
            terrain: Uneven,
            exits: {
                "west": "deer_meadow",
            },
            environment: Field,
        ),
        "brook_ford": (
            name: "Brook Ford",
            description: "A clear brook runs wide and shallow over gravel here, and the bank is churned to mud by hooves and paws: every creature in the woods comes here to drink. Watercress grows thick at the edges. Downstream, the water deepens into reeds.",
            terrain: Mud,
            exits: {
                "north": "deer_meadow",
                "west": "bramble_thicket",
                "east": "brook_bank",
                "south": "reed_pool",
            },
            environment: Water,
        ),
        "brook_bank": (
            name: "Brook Bank",
            description: "The brook runs deeper here, under overhanging alders, its banks steep and undercut. Roots trail in the water. A path follows the bank south, worn by something low and heavy.",
            terrain: Uneven,
            exits: {
                "west": "brook_ford",
                "south": "sett_bank",
            },
            environment: Forest,
        ),
        "bramble_thicket": (
            name: "Bramble Thicket",
            description: "Brambles grow higher than your head, a tangle of thorny arches you have to push and duck through. Tufts of coarse dark hair hang on the thorns, and the ground is trampled into narrow runs.",
            terrain: Rough,
            exits: {
                "north": "meadow_edge",
                "east": "brook_ford",
                "south": "boar_wallow",
            },
            environment: Forest,
        ),
        "boar_wallow": (
            name: "Boar Wallow",
            description: "A hollow in the trees has been churned into a stinking wallow of black mud. The trunks around it are rubbed bare and smeared with mud to the height of your waist. Something big lives here.",
            terrain: Mud,
            exits: {
                "north": "bramble_thicket",
                "east": "reed_pool",
            },
            environment: Forest,
        ),
        "reed_pool": (
            name: "Reed Pool",
            description: "The brook spreads into a still, brown pool, choked with reeds and lily pads. Things plop into the water as you come near. The mud at the edge sucks at your feet.",
            terrain: Wading,
            exits: {
                "north": "brook_ford",
                "west": "boar_wallow",
                "east": "sett_bank",
            },
            environment: Water,
        ),
        "sett_bank": (
            name: "Sett Bank",
            description: "A steep, sandy bank under old oaks, riddled with holes: a badger sett, generations old. Mounds of fresh-dug earth and old bedding spill from the entrances. Beyond, the trees close in, dark and old.",
            terrain: Uneven,
            exits: {
                "north": "brook_bank",
                "west": "reed_pool",
            },
            environment: Forest,
        ),
        "clearing": (
            name: "Hermit's Clearing",
            description: "The trees draw back around a ring of standing stones, each daubed with faded ochre spirals. A low hut of woven branches leans against the largest stone, and a thin thread of smoke rises from a fire that never quite goes out.",
            terrain: Uneven,
            exits: {
                "south": "north_road",
            },
            environment: Forest,
        ),
        "bend": (
            name: "The Bend",
            description: "The road continues along until it reaches a fork.",
            terrain: Road,
            exits: {
                "east": "east_road",
                "north": "north_road",
                "south": "road",
                "west": "woodcutters_track",
            },
            environment: Forest,
        ),
        "east_road": (
            name: "East Road",
            description: "The road runs along the lip of a steep ravine. Below, through a tangle of roots and ferns, something pale glimmers among the rocks. The way down is a hard climb.",
            terrain: Road,
            exits: {
                "down": (to: "ravine", needs: Climb(4)),
                "west": "bend",
            },
            environment: Forest,
        ),
        "ravine": (
            name: "Ravine Floor",
            description: "Moss-slick boulders crowd the bottom of the ravine, where little light reaches. Pale moonpetal grows thick in the damp between the stones, untouched by anyone unwilling to make the climb.",
            terrain: Rough,
            exits: {
                "up": (to: "east_road", needs: Climb(4)),
            },
            environment: Forest,
            finds: {
                "forage": [("wild_berries", 70), ("mushrooms", 30)],
                "herbs": [("kingsfoil", 40), ("moonpetal", 60)],
            },
        ),
        "north_road": (
            name: "North Road",
            description: "The road narrows to a deer track between dark, crowding trees. Somewhere ahead, a thread of woodsmoke hangs in the still air.",
            terrain: Uneven,
            exits: {
                "north": "clearing",
                "south": "bend",
            },
            environment: Forest,
        ),
        "road": (
            name: "Forest Road",
            description: "Twisted trees crowd the path. Something rustles in the undergrowth.",
            terrain: Road,
            exits: {
                "north": "bend",
                "south": "riftwatch:north_gate",
            },
            environment: Forest,
        ),
    },
