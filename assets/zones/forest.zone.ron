(
    name: "Darkwood Forest",
    items: {
        "wild_berries": (
            name: "a handful of wild berries",
            keywords: ["berries", "wild", "handful"],
            description: "Small dark berries, tart and a little bitter, stained purple at the stems.",
            bulk: Negligible,
            tags: ["food"],
            consumable: (by: Eat, effects: [Apply(condition: "nourished", strength: "1", lasts: Minutes(40))]),
            value: 1,
        ),
        "mushrooms": (
            name: "a cluster of mushrooms",
            keywords: ["mushrooms", "cluster"],
            description: "Pale, fleshy caps with brown gills, smelling of damp earth.",
            bulk: Negligible,
            tags: ["food"],
            consumable: (by: Eat, effects: [Apply(condition: "nourished", strength: "2", lasts: Minutes(40))]),
            value: 2,
        ),
        "hazelnuts": (
            name: "a pouchful of hazelnuts",
            keywords: ["hazelnuts", "nuts", "pouchful"],
            description: "A double handful of hazelnuts, cracked and ready to eat.",
            bulk: Negligible,
            tags: ["food"],
            consumable: (by: Eat, effects: [Apply(condition: "nourished", strength: "2", lasts: Minutes(80))]),
            value: 1,
        ),
        "yarrow": (
            name: "a sprig of yarrow",
            keywords: ["yarrow", "sprig"],
            description: "Feathery leaves and a flat head of tiny white flowers. Herbalists pack it into wounds.",
            bulk: Negligible,
            tags: ["herb"],
            value: 4,
        ),
        "kingsfoil": (
            name: "a sprig of kingsfoil",
            keywords: ["kingsfoil", "sprig"],
            description: "Long green leaves that smell sweet and clean when crushed.",
            bulk: Negligible,
            tags: ["herb"],
            value: 8,
        ),
        "moonpetal": (
            name: "a moonpetal blossom",
            keywords: ["moonpetal", "blossom"],
            description: "A pale flower whose petals hold a faint silver sheen, even in shadow.",
            bulk: Negligible,
            tags: ["herb"],
            value: 10,
            rarity: Uncommon,
        ),
        "wild_garlic": (
            name: "a bunch of wild garlic",
            keywords: ["garlic", "wild", "bunch"],
            description: "Broad, bright green leaves that smell strongly of garlic when bruised.",
            bulk: Negligible,
            tags: ["food"],
            consumable: (by: Eat, effects: [Apply(condition: "nourished", strength: "1", lasts: Minutes(40))]),
            value: 1,
        ),
        "sorrel": (
            name: "a handful of sorrel",
            keywords: ["sorrel", "handful"],
            description: "Arrow-shaped leaves with a sharp, lemony taste.",
            bulk: Negligible,
            tags: ["food"],
            consumable: (by: Eat, effects: [Apply(condition: "nourished", strength: "1", lasts: Minutes(40))]),
            value: 1,
        ),
        "watercress": (
            name: "a bunch of watercress",
            keywords: ["watercress", "cress", "bunch"],
            description: "Peppery dark leaves, cold and dripping from the brook.",
            bulk: Negligible,
            tags: ["food"],
            consumable: (by: Eat, effects: [Apply(condition: "nourished", strength: "2", lasts: Minutes(40))]),
            value: 2,
        ),
        "chamomile": (
            name: "a sprig of chamomile",
            keywords: ["chamomile", "sprig"],
            description: "Small daisy-like flowers with yellow hearts, smelling faintly of apples.",
            bulk: Negligible,
            tags: ["herb"],
            value: 5,
        ),
        "hunting_knife": (
            name: "a hunting knife",
            keywords: ["knife", "hunting", "blade"],
            description: "A broad, single-edged knife with an antler grip, sharp enough to shave with and heavy enough to work a carcass.",
            tags: ["blade"],
            weapon: (skill: "knives:basics", damage: (1, 5)),
            value: 35,
        ),
        "rabbit_pelt": (
            name: "a rabbit pelt",
            keywords: ["pelt", "rabbit", "fur"],
            description: "A soft brown pelt, still a little damp on the skin side. Good for a glove lining, or a child's hat.",
            bulk: Light,
            tags: ["pelt"],
            value: 4,
        ),
        "rabbit_meat": (
            name: "a joint of rabbit",
            keywords: ["rabbit", "joint", "meat"],
            description: "A skinned, jointed rabbit, lean and dark. It wants a pot and some wild garlic.",
            bulk: Light,
            tags: ["meat"],
            value: 2,
        ),
        "fox_pelt": (
            name: "a fox pelt",
            keywords: ["pelt", "fox", "fur"],
            description: "A russet fox pelt with a white-tipped brush, thick and glossy. Furriers in town pay well for a clean one.",
            bulk: Bulk(1),
            tags: ["pelt"],
            value: 10,
        ),
        "deer_hide": (
            name: "a deer hide",
            keywords: ["hide", "deer", "skin"],
            description: "A large russet hide, heavy and stiff, waiting for a tanner.",
            bulk: Bulk(3),
            tags: ["pelt"],
            value: 15,
        ),
        "venison": (
            name: "a haunch of venison",
            keywords: ["venison", "haunch", "meat"],
            description: "A heavy haunch of dark red meat, wrapped in leaves. Enough to feed a table.",
            bulk: Bulk(2),
            tags: ["meat"],
            value: 6,
        ),
        "stag_antlers": (
            name: "a stag's antlers",
            keywords: ["antlers", "stag", "trophy"],
            description: "A great spread of twelve-pointed antlers, still joined at the skull. Someone will want them over a hearth.",
            bulk: Bulk(3),
            tags: ["trophy"],
            value: 30,
        ),
        "boar_hide": (
            name: "a boar hide",
            keywords: ["hide", "boar", "skin"],
            description: "A tough, bristly hide, thick enough to turn a careless blade.",
            bulk: Bulk(2),
            tags: ["pelt"],
            value: 12,
        ),
        "boar_meat": (
            name: "a side of boar",
            keywords: ["boar", "side", "meat", "pork"],
            description: "A fatty side of wild boar, gamier than any farm pig.",
            bulk: Bulk(2),
            tags: ["meat"],
            value: 5,
        ),
        "boar_tusks": (
            name: "a pair of boar tusks",
            keywords: ["tusks", "boar", "trophy"],
            description: "Two curved yellow tusks as long as your hand, their edges worn sharp.",
            bulk: Light,
            tags: ["trophy"],
            value: 20,
        ),
        "frog_legs": (
            name: "a pair of frog legs",
            keywords: ["legs", "frog", "meat"],
            description: "Two long, pale frog legs, each as big as a chicken's. The kitchen in town won't ask where they came from.",
            bulk: Light,
            tags: ["meat"],
            value: 3,
        ),
        "badger_pelt": (
            name: "a badger pelt",
            keywords: ["pelt", "badger", "fur"],
            description: "A coarse grey pelt with a striped face, the hair stiff enough for shaving brushes.",
            bulk: Bulk(1),
            tags: ["pelt"],
            value: 12,
        ),
    },
    mobs: {
        "hunter": (
            name: "the hunter",
            race: "human",
            keywords: ["hunter", "woman"],
            here: "The hunter sits by the cold kilns, scraping a hide stretched on a frame.",
            description: "A lean, weathered woman in stained leathers, her grey hair cropped short and a skinning knife always somewhere near her hand. She moved into the old charcoal burners' camp last spring, and the town has been eating better since. She watches the trees more than she watches you.",
            attributes: {Agility: 5, Intuition: 6, Reaction: 4},
            skills: {"survival:foraging": 25, "survival:tracking": 25, "knives:basics": 20},
            attack: "knives:basics",
            equipment: ["hunting_knife"],
            teaches: ["survival:foraging", "survival:tracking", "survival:skinning", "survival:butchering"],
            shop: (
                sells: ["hunting_knife", "riftwatch:waterskin", "riftwatch:torch"],
                buys: ["trophy", "pelt", "meat"],
            ),
        ),
        "crow": (
            name: "a crow",
            keywords: ["crow", "bird"],
            here: "A crow watches from a low branch, head cocked.",
            description: "A glossy black crow, bigger than you'd like, with a heavy beak and an unblinking eye. It doesn't seem in any hurry to leave.",
            attributes: {Body: 1, Strength: 1, Agility: 4, Reaction: 4},
            skills: {"beast:peck": 1},
            attack: "beast:peck",
            health: 2,
        ),
        "rabbit": (
            name: "a rabbit",
            tags: ["game"],
            keywords: ["rabbit", "bunny"],
            here: "A brown rabbit sits up in the grass, ears high.",
            description: "A plump brown rabbit with a white scut and long, twitching ears. Its nose never stops moving.",
            attributes: {Body: 1, Strength: 1, Agility: 4, Reaction: 5},
            skills: {"beast:bite": 1},
            attack: "beast:bite",
            health: 3,
            avoids: ["boar"],
            traits: ["skittish"],
            harvest: {"hide": [("rabbit_pelt", 1)], "meat": [("rabbit_meat", 1)]},
        ),
        "fox": (
            name: "a fox",
            keywords: ["fox", "red"],
            here: "A red fox picks its way along the edge of the trees.",
            description: "A slim red fox with a white-tipped brush and black stockings. It looks at you the way it looks at everything: as something it might eat, or might need to run from.",
            attributes: {Body: 2, Strength: 2, Agility: 5, Reaction: 5},
            skills: {"beast:bite": 3},
            attack: "beast:bite",
            health: 6,
            avoids: ["boar"],
            traits: ["skittish"],
            harvest: {"hide": [("fox_pelt", 1)]},
        ),
        "adder": (
            name: "an adder",
            tags: ["snake"],
            keywords: ["adder", "snake", "viper"],
            here: "An adder lies basking on a warm stone, zigzag back to the sun.",
            description: "A thick, short snake with a dark zigzag down its grey back and a red eye. It doesn't move, but it knows exactly where you are.",
            attributes: {Body: 1, Strength: 2, Agility: 4, Reaction: 4},
            skills: {"beast:bite": 3},
            attack: "beast:bite",
            health: 4,
            // Strikes at people who come near; leaves the beasts be.
            aggressive: true,
            traits: ["venomous"],
        ),
        "red_deer": (
            name: "a red deer",
            tags: ["game", "deer"],
            allies: ["deer"],
            keywords: ["red", "deer", "hind"],
            here: "A red deer grazes, lifting her head every few mouthfuls to listen.",
            description: "A tall hind with a russet coat and a pale rump, all long legs and big dark eyes. Every part of her is ready to run.",
            attributes: {Body: 3, Strength: 2, Agility: 4, Reaction: 5},
            skills: {"beast:hooves": 3},
            attack: "beast:hooves",
            health: 10,
            avoids: ["boar"],
            traits: ["skittish"],
            harvest: {"hide": [("deer_hide", 1)], "meat": [("venison", 1)]},
        ),
        "red_stag": (
            name: "a red stag",
            tags: ["game", "deer"],
            allies: ["deer"],
            keywords: ["red", "stag", "deer"],
            here: "A red stag stands over the herd, crowned with a great spread of antlers.",
            description: "A heavy-shouldered stag with a shaggy neck and twelve points on his antlers. He doesn't run like the hinds. He watches you, and lowers his head.",
            attributes: {Body: 5, Strength: 5, Agility: 3, Reaction: 4},
            skills: {"beast:antlers": 8},
            attack: "beast:antlers",
            health: 25,
            tactics: 20,
            harvest: {"hide": [("deer_hide", 1)], "meat": [("venison", 60), ("stag_antlers", 40)]},
        ),
        "young_boar": (
            name: "a young boar",
            tags: ["boar"],
            allies: ["boar"],
            keywords: ["young", "boar", "pig"],
            here: "A young boar roots in the leaf litter, grunting.",
            description: "A bristly, striped-backed boar not long out of the litter, all shoulders and snout, with tusks just starting to show. It has all of a boar's temper and none of its sense.",
            attributes: {Body: 3, Strength: 3, Agility: 2, Reaction: 3},
            skills: {"beast:gore": 3},
            attack: "beast:gore",
            health: 10,
            aggressive: true,
            harvest: {"hide": [(None, 50), ("boar_hide", 50)], "meat": [("boar_meat", 1)]},
        ),
        "wild_boar": (
            name: "a wild boar",
            tags: ["boar"],
            allies: ["boar"],
            keywords: ["wild", "boar", "pig"],
            here: "A wild boar stands knee-deep in the wallow, small eyes fixed on you.",
            description: "A huge, bristling boar, black with mud to the shoulder, with yellow tusks as long as your hand. It weighs more than you do, and it's in a bad mood.",
            attributes: {Body: 5, Strength: 4, Agility: 2, Reaction: 3},
            skills: {"beast:gore": 6, "beast:charge": 6},
            attack: "beast:gore",
            health: 18,
            tactics: 30,
            aggressive: true,
            traits: ["furious"],
            harvest: {"hide": [("boar_hide", 1)], "meat": [("boar_meat", 70), ("boar_tusks", 30)]},
        ),
        "giant_frog": (
            name: "a giant frog",
            keywords: ["giant", "frog"],
            here: "A giant frog squats among the reeds, throat pulsing.",
            description: "A mottled green frog the size of a dog, with gold eyes and a wide, wet mouth. It sits very still, and then it doesn't.",
            attributes: {Body: 2, Strength: 2, Agility: 4, Reaction: 3},
            skills: {"beast:bite": 4, "beast:tongue": 4},
            attack: "beast:bite",
            health: 8,
            tactics: 30,
            // Leaps out at people who come near; leaves the beasts be.
            aggressive: true,
            harvest: {"meat": [("frog_legs", 1)]},
        ),
        "badger": (
            name: "a badger",
            keywords: ["badger", "brock"],
            here: "A badger shuffles about the mouth of its sett, black-and-white face low.",
            description: "A broad, low badger with a striped face and grey, coarse fur over a body that's mostly muscle. It doesn't want trouble, and it will finish any it's given.",
            attributes: {Body: 5, Strength: 3, Agility: 2, Reaction: 3},
            skills: {"beast:bite": 5},
            attack: "beast:bite",
            health: 14,
            traits: ["thick_hide"],
            harvest: {"hide": [("badger_pelt", 1)]},
        ),
        "hedge_shaman": (
            name: "the hedge-shaman",
            race: "human",
            keywords: ["hedge", "shaman", "hermit"],
            here: "The hedge-shaman crouches by a smoking fire, talking quietly to no one you can see.",
            description: "A wiry figure in layers of moss-dyed cloth, hung with feathers, bones and tiny clay charms. Their eyes are bright and a little wild, and they answer questions you haven't asked aloud.",
            attributes: {Charisma: 6, Willpower: 5, Magic: 4},
            skills: {"shamanic:foundation": 20},
            spells: ["shamanic:beast_speech", "shamanic:spirit_grasp"],
            teaches: [
                "shamanic:foundation", "shamanic:beast_speech", "shamanic:spirit_grasp",
                "survival:tracking",
            ],
        ),
    },
