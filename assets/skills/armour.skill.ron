// A skill tree. Its id is the file name: skills here are `armour:<id>`.
(
    name: "Armour",
    rarity: Common,
    attribute: Body,
    skills: {
        // Fighting in armour without it hampering you. No text: it trains on every hit taken in
        // armour, which would be too often to tell.
        "heavy_armour": (
            name: "Heavy Armour",
            description: "Moving and fighting in armour as if it weighed less. Every hit you take in armour trains it, and it eases armour's penalty to your defence, a tenth of a point with every level.",
            kind: Passive(
                triggers: [HitInArmour],
                bonuses: [(stat: ArmourEase, per: 10)],
            ),
        ),
    },
)
