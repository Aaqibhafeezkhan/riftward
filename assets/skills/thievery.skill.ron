// A skill tree. Its id is the file name: skills here are `thievery:<id>`.
(
    name: "Thievery",
    rarity: Common,
    attribute: Agility,
    skills: {
        // `pick` fills in {target} as the lock and {door} as what it's on; `beyond` is heard on
        // the other side of a door.
        "lockpicking": (
            name: "Lockpicking",
            description: "Opening locks without their keys, with 'use lockpicking <door or container>' or 'pick <door or container>', if you have lockpicks. Your Lockpicking (level plus Agility) against how hard the lock is to pick; some can't be picked at all.",
            kind: Active(
                tool: "lockpick",
                aim: Lock,
                cost: Stamina(1),
                cooldown: 2,
                against: "target.pick",
                effects: [Remove(condition: "locked")],
            ),
            text: (
                hit: (
                    actor: "You work at {target} until it gives with a click.",
                    room: "{actor} picks {target}.",
                    beyond: "You hear a faint click from {door}.",
                ),
                miss: (
                    actor: "You work at {target}, but it won't give.",
                    room: "{actor} fiddles with {target}.",
                    beyond: "Something scratches at {door}.",
                ),
            ),
        ),
        "pickpocketing": (
            name: "Pickpocketing",
            description: "Lifting coins from someone's purse without their noticing, with 'steal <someone>' (or 'use pickpocketing <someone>'). Your Pickpocketing (level plus Agility) against their Intuition; the cleaner the lift, the more you get, up to all they carry. Caught, they'll turn on you. Not from other players.",
            // A share of their purse, by how cleanly it went: all of it at three times their
            // wits, at least a copper if they have one.
            kind: Active(
                aim: Other,
                cost: Stamina(1),
                cooldown: 5,
                resist: Attribute(Intuition),
                provokes: true,
                effects: [Take(Coins("max(1, floor(target.coins * min(1, margin / 3)))"))],
            ),
            text: (
                hit: (
                    actor: "You slip a hand into {target}'s pocket, unnoticed, and come away with {coins}.",
                    room: "{actor} brushes past {target}.",
                ),
                miss: (
                    actor: "{target} catches your hand in their pocket!",
                    target: "You catch {actor} with a hand in your pocket!",
                    room: "{target} catches {actor} with a hand in their pocket!",
                ),
            ),
        ),
    },
)
