// A skill tree. Its id is the file name: skills here are `axes:<id>`.
(
    name: "Axes",
    rarity: Common,
    attribute: Strength,
    skills: {
        // A weapon skill: no damage of its own, it needs a weapon that uses it in hand.
        "basics": (
            name: "Axe Fighting",
            description: "Fighting with an axe: heavy, simple blows. Your skill and Strength are your aim, every level of it counting, and the more surely you land a blow, the harder it hits, from a glancing one to a crushing one. You do the axe's damage.",
            kind: Attack(),
            text: (
                hit: (
                    actor: "Your hack {harm} {target}.",
                    target: "{actor}'s hack {harm} you.",
                    room: "{actor}'s hack {harm} {target}.",
                ),
                miss: (
                    actor: "You hack at {target}, but miss.",
                    target: "{actor} hacks at you, but misses.",
                    room: "{actor} hacks at {target}, but misses.",
                ),
            ),
        ),
        "cleave": (
            name: "Cleave",
            description: "A great swing that carries on into a second foe fighting you, even when it fells the first.",
            kind: Technique((with: "axes:basics", cost: Stamina(3), effects: [Cleave])),
            requires: Skill("axes:basics", 15),
            karma: 12,
            text: (
                hit: (
                    actor: "Your cleave {harm} {target}.",
                    target: "{actor}'s cleave {harm} you.",
                    room: "{actor}'s cleave {harm} {target}.",
                ),
                miss: (
                    actor: "You swing wide at {target}, and miss.",
                    target: "{actor} swings wide at you, but misses.",
                    room: "{actor} swings wide at {target}, but misses.",
                ),
            ),
        ),
        "hew": (
            name: "Hew",
            description: "A huge, slow chop: 3 more damage, but harder to land.",
            kind: Technique((with: "axes:basics", cost: Stamina(2), damage: 3, accuracy: -2)),
            requires: Skill("axes:basics", 15),
            karma: 8,
            text: (
                hit: (
                    actor: "Your hewing chop {harm} {target}.",
                    target: "{actor}'s hewing chop {harm} you.",
                    room: "{actor}'s hewing chop {harm} {target}.",
                ),
                miss: (
                    actor: "You hew at {target}, but the blow goes wide.",
                    target: "{actor} hews at you, but misses.",
                    room: "{actor} hews at {target}, but misses.",
                ),
            ),
        ),
    },
)
