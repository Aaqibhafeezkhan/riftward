// A skill tree. Its id is the file name: skills here are `axes:<id>`.
(
    name: "Axes",
    rarity: Common,
    attribute: Strength,
    skills: {
        // A weapon skill: no damage of its own, it needs a weapon that uses it in hand.
        "basics": (
            name: "Axe Fighting",
            kind: Attack(verb: "hack"),
        ),
        "cleave": (
            name: "Cleave",
            kind: Technique((with: "axes:basics", verb: "cleave", cost: Stamina(3),
                effects: [Cleave])),
            requires: Skill("axes:basics", 15),
        ),
        "hew": (
            name: "Hew",
            kind: Technique((with: "axes:basics", verb: "hew at", cost: Stamina(2), damage: 3,
                accuracy: -2)),
            requires: Skill("axes:basics", 15),
        ),
    },
)
