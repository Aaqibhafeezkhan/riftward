// A skill tree. Its id is the file name: skills here are `knives:<id>`.
(
    name: "Knives",
    rarity: Common,
    attribute: Agility,
    skills: {
        // A weapon skill: no damage of its own, it needs a weapon that uses it in hand.
        "basics": (
            name: "Knife Fighting",
            kind: Attack(verb: "stab"),
        ),
        "backstab": (
            name: "Backstab",
            kind: Technique((with: "knives:basics", verb: "stab", cost: Stamina(2), damage: 4,
                opener: true)),
            requires: Skill("knives:basics", 15),
        ),
        "open_vein": (
            name: "Open Vein",
            kind: Technique((with: "knives:basics", verb: "slash", cost: Stamina(2),
                effects: [Bleed(damage: 1, rounds: 3)])),
            requires: Skill("knives:basics", 15),
        ),
    },
)
