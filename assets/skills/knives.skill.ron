// A skill tree. Its id is the file name: skills here are `knives:<id>`.
(
    name: "Knives",
    rarity: Common,
    attribute: Agility,
    skills: {
        // A weapon skill: no damage of its own, it needs a weapon that uses it in hand.
        "basics": (
            name: "Knife Fighting",
            kind: Attack(verb: "stab"),
        ),
    },
)
