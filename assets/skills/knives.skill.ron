// A skill tree. Its id is the file name: skills here are `knives:<id>`.
(
    name: "Knives",
    rarity: Common,
    attribute: Agility,
    skills: {
        // A weapon skill: no damage of its own, it needs a weapon that uses it in hand.
        "basics": (
            name: "Knife Fighting",
            description: "Fighting with a knife: quick, close and nasty. You do the knife's damage, and a point more for every 10 levels.",
            kind: Attack(),
            text: (
                hit: (
                    actor: "Your stab {harm} {target}.",
                    target: "{actor}'s stab {harm} you.",
                    room: "{actor}'s stab {harm} {target}.",
                ),
                miss: (
                    actor: "You stab at {target}, but miss.",
                    target: "{actor} stabs at you, but misses.",
                    room: "{actor} stabs at {target}, but misses.",
                ),
            ),
        ),
        "backstab": (
            name: "Backstab",
            description: "A knife in the back of someone who isn't ready for it, between the plates of any armour: 4 extra damage, ignoring 2 points of armour. It can start a fight, and lands easily on anyone unaware, down or resting.",
            kind: Technique((with: "knives:basics", cost: Stamina(2), damage: 4, opener: true,
                effects: [Pierce(2)])),
            requires: Skill("knives:basics", 15),
            text: (
                hit: (
                    actor: "Your knife in the back {harm} {target}.",
                    target: "{actor}'s knife in the back {harm} you.",
                    room: "{actor}'s knife in the back {harm} {target}.",
                ),
                miss: (
                    actor: "You strike at {target}'s back, but they twist away.",
                    target: "{actor} strikes at your back, but you twist away.",
                    room: "{actor} strikes at {target}'s back, but misses.",
                ),
            ),
        ),
        "open_vein": (
            name: "Open Vein",
            description: "A slash meant to bleed: the wound keeps hurting for three turns.",
            kind: Technique((with: "knives:basics", cost: Stamina(2),
                effects: [Bleed(damage: 1, rounds: 3)])),
            requires: Skill("knives:basics", 15),
            text: (
                hit: (
                    actor: "Your vein-opening slash {harm} {target}.",
                    target: "{actor}'s vein-opening slash {harm} you.",
                    room: "{actor}'s vein-opening slash {harm} {target}.",
                ),
                miss: (
                    actor: "You slash at {target}, but miss.",
                    target: "{actor} slashes at you, but misses.",
                    room: "{actor} slashes at {target}, but misses.",
                ),
            ),
        ),
    },
)
