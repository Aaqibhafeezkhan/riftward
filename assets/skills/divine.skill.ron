// A magical tradition. Its foundation skill is what Awakens a character to it; it requires latent
// talent (Magic 1), and is taught by the tradition's teachers in the world.
(
    name: "Divine",
    rarity: Uncommon,
    attribute: Intuition,
    skills: {
        // A god's answer to your devotion: the root of all Divine magic.
        "foundation": (
            name: "Faith",
            description: "A god's answer to your devotion. Knowing it, you are Awakened to Divine magic, and it is your first school: blessings and mending.",
            kind: Passive(triggers: []),
            requires: Stat(Magic, 1),
        ),
    },
)
