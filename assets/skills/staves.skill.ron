// A skill tree. Its id is the file name: skills here are `staves:<id>`.
(
    name: "Staves",
    rarity: Common,
    attribute: Agility,
    skills: {
        // A weapon skill: no damage of its own, it needs a weapon that uses it in hand.
        "basics": (
            name: "Staff Fighting",
            kind: Attack(verb: "strike"),
        ),
        "sweep": (
            name: "Sweep",
            kind: Technique((with: "staves:basics", verb: "sweep", cost: Stamina(3),
                effects: [KnockDown])),
            requires: Skill("staves:basics", 15),
        ),
        "guard": (
            name: "Guard",
            kind: Technique((with: "staves:basics", verb: "take a guarding stance",
                cost: Stamina(1), strike: None, effects: [Guard(defence: 4, rounds: 2)])),
            requires: Skill("staves:basics", 15),
        ),
    },
)
