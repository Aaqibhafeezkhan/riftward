// A skill tree. Its id is the file name: skills here are `staves:<id>`.
(
    name: "Staves",
    rarity: Common,
    attribute: Agility,
    skills: {
        // A weapon skill: no damage of its own, it needs a weapon that uses it in hand.
        "basics": (
            name: "Staff Fighting",
            description: "Fighting with a staff: reach, balance and both hands. You do the staff's damage, and a point more for every 10 levels.",
            kind: Attack(),
            text: (
                hit: (
                    actor: "Your strike {harm} {target}.",
                    target: "{actor}'s strike {harm} you.",
                    room: "{actor}'s strike {harm} {target}.",
                ),
                miss: (
                    actor: "You strike at {target}, but miss.",
                    target: "{actor} strikes at you, but misses.",
                    room: "{actor} strikes at {target}, but misses.",
                ),
            ),
        ),
        "sweep": (
            name: "Sweep",
            description: "A low sweep that takes a foe off their feet: they lose their next turn, and defend at half until then.",
            kind: Technique((with: "staves:basics", cost: Stamina(3), effects: [Apply(condition: "down", lasts: Turns(1))])),
            requires: Skill("staves:basics", 15),
            karma: 10,
            text: (
                hit: (
                    actor: "Your sweep {harm} {target}.",
                    target: "{actor}'s sweep {harm} you.",
                    room: "{actor}'s sweep {harm} {target}.",
                ),
                miss: (
                    actor: "You sweep at {target}'s legs, but miss.",
                    target: "{actor} sweeps at you, but misses.",
                    room: "{actor} sweeps at {target}, but misses.",
                ),
            ),
        ),
        "guard": (
            name: "Guard",
            description: "Hold your staff across you instead of attacking: 4 more defence for two turns.",
            kind: Technique((with: "staves:basics", cost: Stamina(1), strike: None,
                effects: [Apply(condition: "guarding", strength: 4, lasts: Turns(2), on: User)])),
            requires: Skill("staves:basics", 15),
            karma: 6,
            text: (
                hit: (
                    actor: "You take a guarding stance.",
                    room: "{actor} takes a guarding stance.",
                ),
            ),
        ),
    },
)
