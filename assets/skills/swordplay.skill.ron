// A skill tree. Its id is the file name: skills here are `swordplay:<id>`.
(
    name: "Swordplay",
    rarity: Common,
    attribute: Agility,
    skills: {
        // A weapon skill: no damage of its own, it needs a sword in hand.
        "basics": (
            name: "Swordplay",
            description: "Fighting with a sword in hand. You do the sword's damage, and a point more for every 10 levels.",
            kind: Attack(),
            text: (
                hit: (
                    actor: "Your slash {harm} {target}.",
                    target: "{actor}'s slash {harm} you.",
                    room: "{actor}'s slash {harm} {target}.",
                ),
                miss: (
                    actor: "You slash at {target}, but miss.",
                    target: "{actor} slashes at you, but misses.",
                    room: "{actor} slashes at {target}, but misses.",
                ),
            ),
        ),
        "lunge": (
            name: "Lunge",
            description: "A long, quick thrust that's hard to avoid and finds a gap in armour (it ignores 1 point of it), but leaves you open until your next turn.",
            kind: Technique((with: "swordplay:basics", cost: Stamina(1), accuracy: 4,
                effects: [Apply(condition: "exposed", lasts: Turns(1), on: User), Pierce(1)])),
            requires: Skill("swordplay:basics", 15),
            karma: 8,
            text: (
                hit: (
                    actor: "Your lunge {harm} {target}.",
                    target: "{actor}'s lunge {harm} you.",
                    room: "{actor}'s lunge {harm} {target}.",
                ),
                miss: (
                    actor: "You lunge at {target}, but the point goes wide.",
                    target: "{actor} lunges at you, but the point goes wide.",
                    room: "{actor} lunges at {target}, but the point goes wide.",
                ),
            ),
        ),
        // After a dodge, a free counter-strike with a sword in hand.
        "riposte": (
            name: "Riposte",
            description: "When you dodge an attack with a sword in hand, you strike back at once, for 1 stamina.",
            kind: Passive(counter: "swordplay:basics"),
            requires: Skill("swordplay:basics", 15),
            karma: 16,
            text: (
                hit: (
                    actor: "You riposte!",
                    target: "{actor} ripostes!",
                    room: "{actor} ripostes against {target}!",
                ),
            ),
        ),
    },
)
