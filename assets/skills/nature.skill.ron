// A skill tree. Its id is the file name: skills here are `nature:<id>`.
(
    name: "Nature",
    rarity: Common,
    attribute: Intuition,
    skills: {
        // `gather` fills in {item} with what was found.
        "herbalism": (
            name: "Herbalism",
            description: "Knowing which plants heal and which harm, and finding them, with 'gather' (or 'use herbalism'). What grows depends on the place. Herbs are the makings of draughts and poultices.",
            kind: Active(aim: Room, cooldown: 3, against: "3", effects: [Find(kind: "herbs")]),
            text: (
                hit: (
                    actor: "You search among the plants and find {item}.",
                    room: "{actor} searches among the plants and gathers {item}.",
                ),
                miss: (
                    actor: "You search among the plants, but find nothing useful.",
                    room: "{actor} searches among the plants, but finds nothing.",
                ),
            ),
        ),
        // Brewing makes draughts from its recipes (assets/recipes/brewing.recipes.ron) with
        // `craft`: {item} is what's made, or what would have been.
        "brewing": (
            name: "Brewing",
            description: "Steeping herbs and stranger things into draughts that heal, cure and harden, in a kettle over a fire, with 'craft <recipe>' (or 'use brewing <recipe>'). Each draught wants a vial to go in. 'recipes' lists what you can make; more come as you improve, and some are taught.",
            kind: Active(command: "craft", cooldown: 2),
            text: (
                hit: (
                    actor: "You brew, and draw off {item}.",
                    room: "{actor} tends a steaming kettle, and draws off {item}.",
                ),
                miss: (
                    actor: "Your brew turns to sludge, and the makings of {item} are ruined.",
                    room: "{actor}'s kettle boils over in a foul-smelling cloud.",
                ),
            ),
        ),
    },
)
