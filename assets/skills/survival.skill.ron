// A skill tree. Its id is the file name: skills here are `survival:<id>`.
(
    name: "Survival",
    rarity: Common,
    attribute: Intuition,
    skills: {
        // `forage` fills in {item} with what was found.
        "foraging": (
            name: "Foraging",
            description: "Finding something to eat in the wild, with 'forage' (or 'use foraging'). What there is depends on the place: berries and nuts in a forest, not much in a sewer. Each place holds only a little, and grows back slowly; the better you search, the better what you find.",
            kind: Active(aim: Room, cooldown: 3, against: "3", effects: [Find(kind: "forage")]),
            text: (
                hit: (
                    actor: "You search the ground and find {item}.",
                    room: "{actor} searches the ground and finds {item}.",
                ),
                miss: (
                    actor: "You search the ground, but find nothing worth having.",
                    room: "{actor} searches the ground, but comes up empty-handed.",
                ),
            ),
        ),
        // `track` lists what was read after the actor's line.
        "tracking": (
            name: "Tracking",
            description: "Reading who passed this way, and which way they went, with 'track [<who>]' (or 'use tracking [<who>]'). Soft ground and fresh tracks are easy; stone and old tracks hard; water holds none.",
            // Each track: the ground's difficulty (mud 1 to paving 8), twice as hard after ten
            // minutes.
            kind: Active(
                aim: Room,
                cooldown: 3,
                quiet: true,
                against: "target.ground * (1 + age / 10)",
                effects: [Reveal(Tracks)],
            ),
            text: (
                hit: (
                    actor: "You study the ground and read the signs:",
                    room: "{actor} studies the ground.",
                ),
                miss: (
                    actor: "You study the ground, but can't make out any tracks.",
                    room: "{actor} studies the ground.",
                ),
            ),
        ),
    },
)
