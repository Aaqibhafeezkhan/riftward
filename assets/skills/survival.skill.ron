// A skill tree. Its id is the file name: skills here are `survival:<id>`.
(
    name: "Survival",
    rarity: Common,
    attribute: Intuition,
    skills: {
        // `forage` fills in {item} with what was found.
        "foraging": (
            name: "Foraging",
            description: "Finding something to eat in the wild, with 'forage'. What there is depends on the place: berries and nuts in a forest, not much in a sewer. Each place holds only a little, and grows back slowly.",
            kind: Active(command: "forage", cooldown: 3),
            text: (
                hit: (
                    actor: "You search the ground and find {item}.",
                    room: "{actor} searches the ground and finds {item}.",
                ),
                miss: (
                    actor: "You search the ground, but find nothing worth having.",
                    room: "{actor} searches the ground, but comes up empty-handed.",
                ),
            ),
        ),
    },
)
