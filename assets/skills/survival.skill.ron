// A skill tree. Its id is the file name: skills here are `survival:<id>`.
(
    name: "Survival",
    rarity: Common,
    attribute: Intuition,
    skills: {
        // `forage` fills in {item} with what was found.
        "foraging": (
            name: "Foraging",
            description: "Finding something to eat in the wild, with 'forage' (or 'use foraging'). What there is depends on the place: berries and nuts in a forest, not much in a sewer. Each place holds only a little, and grows back slowly; the better you search, the better what you find.",
            kind: Active(aim: Room, cooldown: 3, against: "3", effects: [Find(kind: "forage")]),
            text: (
                hit: (
                    actor: "You search the ground and find {item}.",
                    room: "{actor} searches the ground and finds {item}.",
                ),
                miss: (
                    actor: "You search the ground, but find nothing worth having.",
                    room: "{actor} searches the ground, but comes up empty-handed.",
                ),
            ),
        ),
        // Skinning and Butchering are aimed at a beast's corpse (`skin`, `butcher`): {target} is
        // the corpse, {item} what was cut from it. What a beast yields is its template's
        // `harvest`; each kind once per corpse, and a botched cut spoils it.
        "skinning": (
            name: "Skinning",
            description: "Taking the hide or pelt from a beast's corpse before it rots, with 'skin [<corpse>]' (or 'use skinning <corpse>'), with a blade on you. A clumsy cut spoils it; a clean one is worth more.",
            attribute: Agility,
            kind: Active(aim: Item, tool: "blade", cooldown: 2, against: "3", effects: [Find(kind: "hide")]),
            text: (
                hit: (
                    actor: "You work your blade under the skin of {target}, and take {item}.",
                    room: "{actor} skins {target}, and takes {item}.",
                ),
                miss: (
                    actor: "You hack at {target}, but the hide tears and is spoiled.",
                    room: "{actor} hacks at {target}, spoiling the hide.",
                ),
            ),
        ),
        "butchering": (
            name: "Butchering",
            description: "Cutting meat and trophies (antlers, tusks, fangs) from a beast's corpse before it rots, with 'butcher [<corpse>]' (or 'use butchering <corpse>'), with a blade on you. A clumsy job wastes it; a clean one is worth more.",
            attribute: Agility,
            kind: Active(aim: Item, tool: "blade", cooldown: 2, against: "3", effects: [Find(kind: "meat")]),
            text: (
                hit: (
                    actor: "You butcher {target}, and take {item}.",
                    room: "{actor} butchers {target}, and takes {item}.",
                ),
                miss: (
                    actor: "You butcher {target} badly, and nothing is worth keeping.",
                    room: "{actor} makes a mess of butchering {target}.",
                ),
            ),
        ),
        // `track` lists what was read after the actor's line.
        "tracking": (
            name: "Tracking",
            description: "Reading who passed this way, and which way they went, with 'track [<who>]' (or 'use tracking [<who>]'). Soft ground and fresh tracks are easy; stone and old tracks hard; water holds none.",
            // Each track: the ground's difficulty (mud 1 to paving 8), twice as hard after ten
            // minutes.
            kind: Active(
                aim: Room,
                cooldown: 3,
                quiet: true,
                against: "target.ground * (1 + age / 10)",
                effects: [Reveal(Tracks)],
            ),
            text: (
                hit: (
                    actor: "You study the ground and read the signs:",
                    room: "{actor} studies the ground.",
                ),
                miss: (
                    actor: "You study the ground, but can't make out any tracks.",
                    room: "{actor} studies the ground.",
                ),
            ),
        ),
    },
)
