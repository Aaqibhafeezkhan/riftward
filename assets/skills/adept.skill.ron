// A magical tradition. Its foundation skill is what Awakens a character to it; it requires latent
// talent (Magic 1), and is taught by the tradition's teachers in the world. Adepts have no spells:
// their magic is turned inward as powers, which are skills like any other.
(
    name: "Adept",
    rarity: Uncommon,
    attribute: Body,
    skills: {
        // Magic turned inward, through breath and body: the root of all Adept powers. It's the
        // Adept's school: every attack made, armed or not, and every power used practise it. It
        // sharpens every attack and deepens the breath whatever you fight with, and the hands most.
        "foundation": (
            name: "Inner Discipline",
            description: "Magic turned inward through breath and body. Knowing it, you are Awakened as an Adept. It sharpens every attack you make, a tenth of a point with every level, and deepens your breath, a point of stamina with every level; Killing Hands it strengthens most of all. Every attack you make, with a sword or your fists, and every power you use train it.",
            kind: Passive(
                triggers: [UsedTree, UsedAttack],
                bonuses: [
                    (stat: Attack, per: 10),
                    (stat: MaxStamina, per: 1),
                    (stat: Attack, per: 5, with: "adept:killing_hands"),
                    (stat: Damage, per: 10, with: "adept:killing_hands"),
                ],
            ),
            requires: Stat(Magic, 1),
        ),
        // The Adept's weapon: unarmed strikes that land like a blade.
        "killing_hands": (
            name: "Killing Hands",
            description: "Unarmed strikes that land like a blade, for 2 to 4 damage, stronger as your Inner Discipline grows.",
            attribute: Agility,
            kind: Attack(damage: (2, 4)),
            requires: Skill("adept:foundation", 0),
            karma: 10,
            text: (
                hit: (
                    actor: "Your open-handed strike {harm} {target}.",
                    target: "{actor}'s open-handed strike {harm} you.",
                    room: "{actor}'s open-handed strike {harm} {target}.",
                ),
                miss: (
                    actor: "You strike at {target}, but miss.",
                    target: "{actor} strikes at you, but misses.",
                    room: "{actor} strikes at {target}, but misses.",
                ),
            ),
        ),
        "quickened_reflexes": (
            name: "Quickened Reflexes",
            description: "Magic sharpening your reflexes: you act sooner in a fight and are harder to hit. Dodging trains it.",
            attribute: Reaction,
            kind: Passive(
                triggers: [Dodged],
                bonuses: [(stat: Initiative, per: 5, base: 1), (stat: Defence, per: 10)],
            ),
            requires: Skill("adept:foundation", 5),
            karma: 12,
        ),
    },
)
