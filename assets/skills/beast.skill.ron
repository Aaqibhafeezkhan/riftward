// Natural attacks for animals and monsters. Players can't learn these, since nothing teaches
// them; mobs are given them in their templates.
(
    name: "Beast",
    rarity: Common,
    attribute: Agility,
    skills: {
        "bite": (
            name: "Bite",
            description: "A beast's bite.",
            kind: Attack(damage: (1, 2)),
            text: (
                hit: (
                    actor: "Your bite {harm} {target}.",
                    target: "{actor}'s bite {harm} you.",
                    room: "{actor}'s bite {harm} {target}.",
                ),
                miss: (
                    actor: "You snap at {target}, but miss.",
                    target: "{actor} snaps at you, but misses.",
                    room: "{actor} snaps at {target}, but misses.",
                ),
            ),
        ),
        "rat_bite": (
            name: "Rat Bite",
            description: "A rat's small, sharp bite.",
            kind: Attack(damage: (1, 1)),
            text: (
                hit: (
                    actor: "Your bite {harm} {target}.",
                    target: "{actor}'s bite {harm} you.",
                    room: "{actor}'s bite {harm} {target}.",
                ),
                miss: (
                    actor: "You snap at {target}, but miss.",
                    target: "{actor} snaps at you, but misses.",
                    room: "{actor} snaps at {target}, but misses.",
                ),
            ),
        ),
        "claw": (
            name: "Claw",
            description: "Raking claws.",
            kind: Attack(damage: (1, 3)),
            text: (
                hit: (
                    actor: "Your claw {harm} {target}.",
                    target: "{actor}'s claw {harm} you.",
                    room: "{actor}'s claw {harm} {target}.",
                ),
                miss: (
                    actor: "You claw at {target}, but miss.",
                    target: "{actor} claws at you, but misses.",
                    room: "{actor} claws at {target}, but misses.",
                ),
            ),
        ),
        // Raking claws that leave wounds bleeding.
        "rend": (
            name: "Rend",
            description: "Claws that tear, leaving wounds that bleed for three turns.",
            kind: Technique((with: "beast:claw", cost: Stamina(2),
                effects: [Apply(condition: "bleeding", lasts: Turns(3))])),
            text: (
                hit: (
                    actor: "Your rake {harm} {target}.",
                    target: "{actor}'s rake {harm} you.",
                    room: "{actor}'s rake {harm} {target}.",
                ),
                miss: (
                    actor: "You rake at {target}, but miss.",
                    target: "{actor} rakes at you, but misses.",
                    room: "{actor} rakes at {target}, but misses.",
                ),
            ),
        ),
        "rat_kings_command": (
            name: "Rat King's Command",
            description: "The Rat King's will over the rats of the sewers: while he lives, they fight harder.",
            kind: Aura(affects: "sewers:sewer_rat", bonus: (attack: 2, defence: 2, armour: 1)),
        ),
        // Prey: a window a quick hunter can strike into, then gone (docs/darkwood.md#prey).
        "skittish": (
            name: "Skittish",
            description: "A wild thing's nerves: anyone it doesn't count a friend coming near startles it, and a moment later it bolts. Caught in a fight, it tries to break away, and surely once badly hurt.",
            kind: Passive(
                reactions: [
                    (
                        on: Arrives,
                        only: Foes,
                        effects: [Apply(condition: "startled", lasts: Rounds(2), on: User)],
                        text: (
                            actor: "You start at {target}.",
                            target: "{actor} starts at the sight of you.",
                            room: "{actor} starts at the sight of {target}.",
                        ),
                    ),
                    (
                        on: TurnStarts,
                        chance: "0.5",
                        effects: [Flee],
                        text: (actor: "You look for a way out.", room: "{actor} looks wildly for a way out."),
                    ),
                    (
                        on: Hurt(0.5),
                        effects: [Flee],
                        text: (actor: "You panic.", room: "{actor} panics."),
                    ),
                ],
            ),
        ),
    },
)
