// Natural attacks for animals and monsters. Players can't learn these, since nothing teaches
// them; mobs are given them in their templates.
(
    name: "Beast",
    rarity: Common,
    attribute: Agility,
    skills: {
        "bite": (
            name: "Bite",
            description: "A beast's bite.",
            kind: Attack(damage: (1, 2)),
            text: (
                hit: (
                    actor: "Your bite {harm} {target}.",
                    target: "{actor}'s bite {harm} you.",
                    room: "{actor}'s bite {harm} {target}.",
                ),
                miss: (
                    actor: "You snap at {target}, but miss.",
                    target: "{actor} snaps at you, but misses.",
                    room: "{actor} snaps at {target}, but misses.",
                ),
            ),
        ),
        "wolf_bite": (
            name: "Wolf Bite",
            description: "A wolf's bite, all teeth and weight behind it.",
            kind: Attack(damage: (2, 4)),
            text: (
                hit: (
                    actor: "Your bite {harm} {target}.",
                    target: "{actor}'s bite {harm} you.",
                    room: "{actor}'s bite {harm} {target}.",
                ),
                miss: (
                    actor: "You lunge at {target}, but your jaws snap shut on air.",
                    target: "{actor} lunges at you, but its jaws snap shut on air.",
                    room: "{actor} lunges at {target}, but its jaws snap shut on air.",
                ),
            ),
        ),
        "fangs": (
            name: "Fangs",
            description: "A spider's curved fangs.",
            kind: Attack(damage: (1, 3)),
            text: (
                hit: (
                    actor: "Your venomous bite {harm} {target}.",
                    target: "{actor}'s venomous bite {harm} you.",
                    room: "{actor}'s venomous bite {harm} {target}.",
                ),
                miss: (
                    actor: "You strike at {target}, but miss.",
                    target: "{actor} strikes at you, but misses.",
                    room: "{actor} strikes at {target}, but misses.",
                ),
            ),
        ),
        "rat_bite": (
            name: "Rat Bite",
            description: "A rat's small, sharp bite.",
            kind: Attack(damage: (1, 1)),
            text: (
                hit: (
                    actor: "Your bite {harm} {target}.",
                    target: "{actor}'s bite {harm} you.",
                    room: "{actor}'s bite {harm} {target}.",
                ),
                miss: (
                    actor: "You snap at {target}, but miss.",
                    target: "{actor} snaps at you, but misses.",
                    room: "{actor} snaps at {target}, but misses.",
                ),
            ),
        ),
        "claw": (
            name: "Claw",
            description: "Raking claws.",
            kind: Attack(damage: (1, 3)),
            text: (
                hit: (
                    actor: "Your claw {harm} {target}.",
                    target: "{actor}'s claw {harm} you.",
                    room: "{actor}'s claw {harm} {target}.",
                ),
                miss: (
                    actor: "You claw at {target}, but miss.",
                    target: "{actor} claws at you, but misses.",
                    room: "{actor} claws at {target}, but misses.",
                ),
            ),
        ),
        // Raking claws that leave wounds bleeding.
        "rend": (
            name: "Rend",
            description: "Claws that tear, leaving wounds that bleed for three turns.",
            kind: Technique((with: "beast:claw", cost: Stamina(2),
                effects: [Apply(condition: "bleeding", lasts: Turns(3))])),
            text: (
                hit: (
                    actor: "Your rake {harm} {target}.",
                    target: "{actor}'s rake {harm} you.",
                    room: "{actor}'s rake {harm} {target}.",
                ),
                miss: (
                    actor: "You rake at {target}, but miss.",
                    target: "{actor} rakes at you, but misses.",
                    room: "{actor} rakes at {target}, but misses.",
                ),
            ),
        ),
        "peck": (
            name: "Peck",
            description: "A bird's sharp beak.",
            kind: Attack(damage: (1, 1)),
            text: (
                hit: (
                    actor: "Your peck {harm} {target}.",
                    target: "{actor}'s peck {harm} you.",
                    room: "{actor}'s peck {harm} {target}.",
                ),
                miss: (
                    actor: "You peck at {target}, but miss.",
                    target: "{actor} pecks at you, but misses.",
                    room: "{actor} pecks at {target}, but misses.",
                ),
            ),
        ),
        "hooves": (
            name: "Hooves",
            description: "A deer's lashing hooves.",
            kind: Attack(damage: (1, 2)),
            text: (
                hit: (
                    actor: "Your hooves {harm} {target}.",
                    target: "{actor}'s hooves {harm} you.",
                    room: "{actor}'s hooves {harm} {target}.",
                ),
                miss: (
                    actor: "You lash out at {target}, but miss.",
                    target: "{actor} lashes out at you with its hooves, but misses.",
                    room: "{actor} lashes out at {target}, but misses.",
                ),
            ),
        ),
        "antlers": (
            name: "Antlers",
            description: "A stag's antlers, lowered and driven home.",
            kind: Attack(damage: (2, 5)),
            text: (
                hit: (
                    actor: "You drive your antlers into {target}, and the blow {harm} them.",
                    target: "{actor} drives its antlers into you, and the blow {harm} you.",
                    room: "{actor} drives its antlers into {target}, and the blow {harm} them.",
                ),
                miss: (
                    actor: "You lower your antlers at {target}, but miss.",
                    target: "{actor} lowers its antlers at you, but you're clear.",
                    room: "{actor} lowers its antlers at {target}, but misses.",
                ),
            ),
        ),
        "rift_antlers": (
            name: "Rift Antlers",
            description: "Antlers that glow with the rift's light, and strike faster than they should.",
            kind: Attack(damage: (3, 7)),
            text: (
                hit: (
                    actor: "Your glowing antlers flicker, and the blow {harm} {target}.",
                    target: "{actor}'s glowing antlers flicker, too fast to follow, and the blow {harm} you.",
                    room: "{actor}'s glowing antlers flicker, and the blow {harm} {target}.",
                ),
                miss: (
                    actor: "You strike at {target}, but miss.",
                    target: "{actor}'s antlers flash past you.",
                    room: "{actor}'s antlers flash past {target}.",
                ),
            ),
        ),
        "gore": (
            name: "Gore",
            description: "A boar's tusks, ripping upward.",
            kind: Attack(damage: (2, 5)),
            text: (
                hit: (
                    actor: "Your tusks {harm} {target}.",
                    target: "{actor}'s tusks {harm} you.",
                    room: "{actor}'s tusks {harm} {target}.",
                ),
                miss: (
                    actor: "You rip at {target} with your tusks, but miss.",
                    target: "{actor} rips at you with its tusks, but misses.",
                    room: "{actor} rips at {target} with its tusks, but misses.",
                ),
            ),
        ),
        "charge": (
            name: "Charge",
            description: "A boar's charge, head down, that knocks its foe off their feet.",
            kind: Technique((with: "beast:gore", cost: Stamina(2), damage: 1,
                effects: [Apply(condition: "down", lasts: Turns(1))])),
            text: (
                hit: (
                    actor: "You charge into {target}, and the blow {harm} them.",
                    target: "{actor} charges into you, and the blow {harm} you.",
                    room: "{actor} charges into {target}, and the blow {harm} them.",
                ),
                miss: (
                    actor: "You charge at {target}, but they step aside.",
                    target: "{actor} charges at you, but you step aside.",
                    room: "{actor} charges at {target}, who steps aside.",
                ),
            ),
        ),
        "tongue": (
            name: "Tongue",
            description: "A giant frog's sticky tongue, lashing out to hold its prey.",
            kind: Technique((with: "beast:bite", cost: Stamina(1), strike: Harmless,
                resist: Some(Attribute(Agility)),
                effects: [Apply(condition: "held", lasts: Turns(2))])),
            text: (
                hit: (
                    actor: "Your tongue lashes out and sticks fast to {target}.",
                    target: "{actor}'s tongue lashes out and sticks fast to you!",
                    room: "{actor}'s tongue lashes out and sticks fast to {target}.",
                ),
                miss: (
                    actor: "Your tongue lashes out at {target}, but misses.",
                    target: "{actor}'s tongue lashes out at you, but you twist aside.",
                    room: "{actor}'s tongue lashes out at {target}, but misses.",
                ),
            ),
        ),
        "acid_touch": (
            name: "Acid Touch",
            description: "A slime's touch, burning with acid.",
            kind: Attack(damage: (1, 2), damage_type: "acid"),
            text: (
                hit: (
                    actor: "Your acid touch {harm} {target}.",
                    target: "{actor}'s acid touch {harm} you.",
                    room: "{actor}'s acid touch {harm} {target}.",
                ),
                miss: (
                    actor: "You flow at {target}, but they're clear.",
                    target: "{actor} flows at you, but you're clear.",
                    room: "{actor} flows at {target}, but misses.",
                ),
            ),
        ),
        "slime_lords_will": (
            name: "Slime Lord's Will",
            description: "The Slime Lord's hold over every slime in the sewers: while it lives, they fight harder.",
            kind: Aura(affects: "slime", bonus: (attack: 1, defence: 1)),
        ),
        "maul": (
            name: "Maul",
            description: "A bear's swipe, claws and the weight of the whole animal behind it.",
            kind: Attack(damage: (3, 6)),
            text: (
                hit: (
                    actor: "Your swipe {harm} {target}.",
                    target: "{actor}'s swipe {harm} you.",
                    room: "{actor}'s swipe {harm} {target}.",
                ),
                miss: (
                    actor: "You swipe at {target}, but they're out of reach.",
                    target: "{actor} swipes at you, and you throw yourself clear.",
                    room: "{actor} swipes at {target}, who throws themselves clear.",
                ),
            ),
        ),
        // A wolf's trip: only with another of the pack on the same prey (`allies: 1`).
        "pull_down": (
            name: "Pull Down",
            description: "A wolf's lunge at the legs while the pack keeps its prey busy, dragging it off its feet.",
            kind: Technique((with: "beast:wolf_bite", cost: Stamina(2), strike: Harmless, allies: 1,
                effects: [Apply(condition: "down", lasts: Turns(1))])),
            text: (
                hit: (
                    actor: "You lunge at {target}'s legs and drag them down.",
                    target: "{actor} lunges at your legs and drags you down!",
                    room: "{actor} lunges at {target}'s legs and drags them down.",
                ),
                miss: (
                    actor: "You lunge at {target}'s legs, but they keep their feet.",
                    target: "{actor} lunges at your legs, but you keep your feet.",
                    room: "{actor} lunges at {target}'s legs, but they keep their feet.",
                ),
            ),
        ),
        // A wolf's Call for Help, in its own words: the pack comes running.
        "howl": (
            name: "Howl",
            description: "Hurt, a wolf howls, and the pack within earshot comes running.",
            kind: Passive(
                reactions: [(
                    on: Hurt(0.5),
                    effects: [CallForHelp(rooms: 3)],
                    text: (
                        actor: "You throw back your head and howl!",
                        target: "{actor} throws back its head and howls!",
                        room: "{actor} throws back its head and howls!",
                    ),
                )],
            ),
        ),
        "old_she_wolfs_lead": (
            name: "The Old She-Wolf's Lead",
            description: "The old she-wolf leads the wolves of the Darkwood: while she lives, they hunt bolder.",
            kind: Aura(affects: "forest:grey_wolf", bonus: (attack: 2, defence: 1)),
        ),
        "rat_kings_command": (
            name: "Rat King's Command",
            description: "The Rat King's will over the rats of the sewers: while he lives, they fight harder.",
            kind: Aura(affects: "sewers:sewer_rat", bonus: (attack: 2, defence: 2, armour: 1)),
        ),
    },
)
