// A skill tree. Its id is the file name: skills here are `athletics:<id>`.
(
    name: "Athletics",
    rarity: Common,
    attribute: Body,
    skills: {
        "dodge": (
            name: "Dodge",
            description: "Getting out of the way. It makes you harder to hit, a point of defence with every level, and every attack you avoid trains it.",
            attribute: Reaction,
            kind: Passive(triggers: [Dodged], bonuses: [(stat: Defence, per: 1)]),
            // Shown instead of a miss when someone who knows it avoids an attack: {actor} is the
            // dodger, {target} the attacker.
            text: (
                hit: (
                    actor: "You dodge {target}'s attack!",
                    target: "{actor} dodges your attack!",
                    room: "{actor} dodges {target}'s attack.",
                ),
            ),
        ),
        "endurance": (
            name: "Endurance",
            description: "Staying power. Every bit of stamina you spend trains it, and it adds a point to your stamina with every level.",
            attribute: Willpower,
            kind: Passive(
                triggers: [StaminaSpent(per: 3)],
                bonuses: [(stat: MaxStamina, per: 1)],
            ),
        ),
        // Climbing and swimming are tried by walking through an exit that needs them; anyone can
        // try, but only the trained practise. {direction} is the exit. A success is told only
        // to the climber, since leaving tells the room; a failure to everyone.
        "climbing": (
            name: "Climbing",
            description: "Getting up and down walls, cliffs and ropes. Some exits need a climb: anyone can try, on Strength alone, but a fall hurts.",
            attribute: Strength,
            kind: Passive(triggers: []),
            text: (
                hit: (
                    actor: "You climb {direction}.",
                    room: "{actor} climbs {direction}.",
                ),
                miss: (
                    actor: "You lose your grip and fall!",
                    room: "{actor} tries to climb {direction}, and falls.",
                ),
            ),
        ),
        "swimming": (
            name: "Swimming",
            description: "Keeping afloat and getting somewhere in deep water. Some exits need a swim: anyone can try, on Body alone, but floundering is exhausting.",
            attribute: Body,
            kind: Passive(triggers: []),
            text: (
                hit: (
                    actor: "You swim {direction}.",
                    room: "{actor} swims {direction}.",
                ),
                miss: (
                    actor: "You flounder, swallow a mouthful of water, and come up coughing.",
                    room: "{actor} tries to swim {direction}, and comes up coughing.",
                ),
            ),
        ),
        "toughness": (
            name: "Toughness",
            description: "Taking a beating and staying up. The damage you take trains it, and it adds a point to your health with every level.",
            kind: Passive(
                triggers: [Damaged(per: 3)],
                bonuses: [(stat: MaxHealth, per: 1)],
            ),
        ),
    },
)
