// A skill tree. Its id is the file name: skills here are `athletics:<id>`.
(
    name: "Athletics",
    rarity: Common,
    attribute: Body,
    skills: {
        "dodge": (
            name: "Dodge",
            attribute: Reaction,
            kind: Passive(triggers: [Dodged]),
        ),
        "endurance": (
            name: "Endurance",
            attribute: Willpower,
            kind: Passive(
                triggers: [StaminaSpent(per: 3)],
                bonuses: [(stat: MaxStamina, per: 5)],
            ),
        ),
        "toughness": (
            name: "Toughness",
            kind: Passive(
                triggers: [Damaged(per: 3)],
                bonuses: [(stat: MaxHealth, per: 5)],
            ),
        ),
    },
)
