// Conditions on places: what a room is like, for good, rather than what's happening to someone.
// A room lists them in its zone file (`conditions: [(condition: "brambles", strength: 1)]`), and
// their reactions answer whoever comes in (`Enters`) and everyone there every so often (`Every`).
// The place has no hands, so a reaction is told as the one it happens to's own: its `actor` line
// to them, its `room` line to everyone else there. `looks` is what `look` shows of it.
// A place's condition can light it (`Lights`: a rift's glow) or darken it past any torch
// (`Darkens`). See docs/world.md#room-conditions.
{
    // The west woods' Bramble Thicket (docs/darkwood.md).
    "brambles": (
        name: "brambles",
        description: "thorny brambles that tear at whoever pushes through",
        tags: ["nature"],
        modifiers: [],
        reactions: [(
            on: Enters,
            effects: [Damage(amount: "roll(1, strength + 1)", type: "physical")],
            text: (
                actor: "A bramble {harm} you as you push through.",
                target: "A bramble {harm} you as you push through.",
                room: "A bramble {harm} {actor} as they push through.",
            ),
        )],
        text: (
            looks: ["Brambles snag at everything here, thick and thorny."],
        ),
    ),
    // A honey tree's bees (docs/darkwood.md, flora): whoever forages or gathers here may be stung.
    "angry_bees": (
        name: "angry bees",
        description: "a nest of bees that take badly to anyone rummaging nearby",
        tags: ["nature"],
        modifiers: [],
        reactions: [(
            on: Gathers,
            chance: "0.5",
            effects: [Damage(amount: "roll(1, 2 + strength)", type: "physical")],
            text: (
                actor: "Bees boil out of the tree, and a sting {harm} you!",
                target: "Bees boil out of the tree, and a sting {harm} you!",
                room: "Bees boil out of the tree around {actor}, and a sting {harm} them!",
            ),
        )],
        text: (
            looks: ["Bees drone in and out of a hollow high in a tree."],
        ),
    ),
    // The Rift-Scar (docs/darkwood.md): a pale glow that lights it at any hour, and a hum that
    // wears at whoever lingers, the stronger the deeper in. A ward takes it; the rift-touched
    // shrug it off. Only the one it hurts is told, so it doesn't fill everyone's screen.
    "rift_hum": (
        name: "the rift's hum",
        description: "a pale glow from nowhere, and a hum that wears at whoever lingers",
        tags: ["rift"],
        modifiers: [Lights],
        reactions: [(
            on: Every(Minutes(4)),
            effects: [Damage(amount: "roll(1, 2 + strength)", type: "force")],
            text: (
                actor: "The hum swells until your teeth ache, and {harm} you.",
                target: "The hum swells until your teeth ache, and {harm} you.",
                room: "",
            ),
        )],
        text: (
            looks: ["The air hums, low and constant, and a pale light comes from nowhere in particular."],
        ),
    ),
    // Spider Hollow's webs (docs/darkwood.md): coming in, you may blunder into one.
    "webs": (
        name: "webs",
        description: "webs strung between the trees, catching whoever blunders in",
        tags: ["nature"],
        modifiers: [],
        reactions: [(
            on: Enters,
            chance: "0.4",
            effects: [Apply(condition: "webbed", lasts: Rounds(3), on: User)],
            text: (actor: "", room: ""),
        )],
        text: (
            looks: ["Webs hang between the trees, grey and heavy, some of them very large."],
        ),
    ),
}
