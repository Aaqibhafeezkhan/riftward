// Conditions: states on a character, as data. See docs/effects.md#conditions.
//
// Each has a name and a description (for `affects`, with {strength}), its tags, how it stacks
// (Replace, Strongest, or Stack(n) doses), its modifiers, and its text. Additive modifiers count
// once per point of strength: Blessed at strength 2 is Attack(1) twice. Text fills in {bearer},
// and {amount} for what hurt or healed. `looks` is what others see: several hints go from fresh to
// nearly spent, chosen by how much strength is left.
//
// How long a condition lasts is up to whatever puts it on: a technique's last turns, a spell's a
// game-time span, an item's while it's worn or held.
{
    // From blows and techniques.
    "staggered": (
        name: "staggered",
        description: "losing your next turn",
        tags: ["physical"],
        modifiers: [LosesTurn],
        text: (
            applied: (bearer: "You are staggered!", room: "{bearer} is staggered!"),
            lost_turn: (bearer: "You reel, staggered, and can't act!", room: "{bearer} reels, staggered."),
        ),
    ),
    "down": (
        name: "down",
        description: "losing your next turn, and defending at half",
        tags: ["physical"],
        modifiers: [LosesTurn, DefenceTimes(0.5)],
        text: (
            applied: (bearer: "You go down!", room: "{bearer} goes down!"),
            lost_turn: (bearer: "You struggle back to your feet.", room: "{bearer} struggles back up."),
            looks: ["{bearer} is down on the ground."],
        ),
    ),
    "bleeding": (
        name: "bleeding",
        description: "losing {strength} health each turn",
        tags: ["physical"],
        modifiers: [HealthEachTurn(-1)],
        text: (
            applied: (bearer: "You are bleeding!", room: "{bearer} is bleeding!"),
            each_turn: (bearer: "You bleed. ({amount})", room: "{bearer} bleeds."),
            kills: (bearer: "You bleed out.", room: "{bearer} bleeds out and falls, dead."),
            looks: ["{bearer} is bleeding."],
        ),
    ),
    "held": (
        name: "held",
        description: "unable to flee, and defending at half",
        tags: ["physical"],
        modifiers: [CantFlee, DefenceTimes(0.5)],
        text: (
            applied: (bearer: "You are caught in a hold!", room: "{bearer} is caught in a hold!"),
            looks: ["{bearer} is held fast."],
        ),
    ),
    "guarding": (
        name: "guarding",
        description: "defending {strength} better",
        tags: ["physical"],
        modifiers: [Defence(1)],
    ),
    "exposed": (
        name: "exposed",
        description: "defending at half until your next turn",
        tags: ["physical"],
        modifiers: [DefenceTimes(0.5)],
    ),
    "stunned": (
        name: "stunned",
        description: "unable to act",
        tags: ["physical"],
        modifiers: [LosesTurn],
        text: (
            applied: (bearer: "You are stunned!", room: "{bearer} is stunned!"),
            lost_turn: (bearer: "You're stunned, and can't act!", room: "{bearer} stands dazed."),
            looks: ["{bearer} looks dazed."],
        ),
    ),

    "asleep": (
        name: "asleep",
        description: "asleep: losing your turns, and defending at half",
        tags: ["sleep", "mind"],
        modifiers: [LosesTurn, DefenceTimes(0.5)],
        text: (
            applied: (bearer: "You fall asleep!", room: "{bearer} falls asleep!"),
            lost_turn: (bearer: "You sleep on, and can't act.", room: "{bearer} sleeps on."),
            looks: ["{bearer} is fast asleep."],
        ),
    ),

    // Harm that lingers.
    "poisoned": (
        name: "poisoned",
        description: "losing {strength} health each turn to poison",
        tags: ["poison", "physical"],
        stacking: Stack(5),
        modifiers: [HealthEachTurn(-1)],
        // Run its course, it leaves the bearer weak a while; cured, it doesn't.
        reactions: [(
            on: Fades,
            effects: [Apply(condition: "weakened", lasts: Minutes(30))],
            text: (
                actor: "The last of the poison leaves you shaking.",
                room: "{actor} shudders as the poison passes.",
            ),
        )],
        text: (
            applied: (bearer: "Poison burns in your veins!", room: "{bearer} is poisoned!"),
            each_turn: (bearer: "The poison burns. ({amount})", room: "{bearer} shudders, sick with poison."),
            kills: (bearer: "The poison takes you.", room: "{bearer} falls, dead of poison."),
            looks: ["{bearer} looks pale and sweating."],
        ),
    ),
    "burning": (
        name: "burning",
        description: "losing {strength} health each turn to fire",
        tags: ["fire"],
        stacking: Strongest,
        modifiers: [HealthEachTurn(-2)],
        text: (
            applied: (bearer: "You catch fire!", room: "{bearer} catches fire!"),
            each_turn: (bearer: "You burn! ({amount})", room: "{bearer} burns!"),
            kills: (bearer: "The flames take you.", room: "{bearer} burns, and falls, dead."),
            looks: ["Flames lick at {bearer}."],
        ),
    ),

    // On weapons, put there by `Imbue`: what they carry into whatever they strike.
    "flaming": (
        name: "flaming",
        description: "burning whatever it strikes, 1 to 3 fire damage for each point of its strength ({strength})",
        tags: ["magic", "fire"],
        modifiers: [],
        on_hit: [Damage(amount: "roll(1, 3) * strength", type: "fire")],
        text: (
            applied: (bearer: "Flames run along your weapon!", room: "Flames run along {bearer}'s weapon!"),
            fades: (bearer: "The flames on your weapon gutter and die.", room: "The flames on {bearer}'s weapon die."),
            looks: ["Flames lick along {bearer}'s weapon."],
        ),
    ),
    "envenomed": (
        name: "envenomed",
        description: "coated in venom that poisons whatever it cuts",
        tags: ["poison"],
        modifiers: [],
        on_hit: [Apply(condition: "poisoned", strength: "strength", lasts: Turns(4))],
        text: (
            applied: (bearer: "Venom glistens on your blade.", room: "Venom glistens on {bearer}'s blade."),
            fades: (bearer: "The last of the venom is gone from your blade."),
        ),
    ),

    // Reacting by themselves.
    "startled": (
        name: "startled",
        description: "startled, and about to bolt",
        tags: [],
        modifiers: [],
        // Put on by Skittish (beast.skill.ron); how long it lasts is the hunter's window.
        reactions: [(
            on: Fades,
            effects: [Flee],
            text: (actor: "You turn to run.", room: "{actor} turns to run."),
        )],
        text: (
            looks: ["{bearer} stands frozen, ready to run."],
        ),
    ),
    "thorns": (
        name: "thorns",
        description: "thorns that tear at whoever strikes you, for {strength} damage",
        tags: ["magic", "nature"],
        modifiers: [],
        reactions: [(
            on: Struck,
            effects: [Damage(amount: "strength", type: "physical")],
            text: (
                actor: "Your thorny hide {harm} {target}.",
                target: "{actor}'s thorny hide {harm} you.",
                room: "{actor}'s thorny hide {harm} {target}.",
            ),
        )],
        text: (
            fades: (bearer: "Your thorns wither away."),
            looks: ["Thorns bristle along {bearer}'s skin."],
        ),
    ),

    // Magic.
    "blessed": (
        name: "blessed",
        description: "attacking {strength} better",
        tags: ["magic", "blessing"],
        modifiers: [Attack(1)],
        text: (
            fades: (bearer: "The warm light of your blessing fades."),
            looks: ["A warm light clings to {bearer}."],
        ),
    ),
    "warded": (
        name: "warded",
        description: "a ward that will take {strength} more damage",
        tags: ["magic"],
        modifiers: [Absorb],
        text: (
            absorbs: (bearer: "Your ward takes the blow ({amount}).", room: "{bearer}'s ward takes the blow."),
            breaks: (bearer: "Your ward fails!", room: "{bearer}'s ward fails."),
            fades: (bearer: "Your ward flickers and fades."),
            looks: [
                "A bright shimmer surrounds {bearer}.",
                "A faint shimmer surrounds {bearer}.",
                "A thin, flickering shimmer clings to {bearer}.",
            ],
        ),
    ),
    // What a meal leaves: recovering faster out of a fight, a quarter as fast again for each point
    // (bread and nuts 2, berries and water 1). Another meal keeps the better, and the longer.
    "nourished": (
        name: "nourished",
        description: "well fed, and recovering faster",
        tags: ["food"],
        stacking: Strongest,
        modifiers: [Recovery(0.25)],
        text: (
            applied: (bearer: "You feel refreshed, and will recover faster for a while."),
            fades: (bearer: "The good of your last meal wears off."),
        ),
    ),
    "regenerating": (
        name: "regenerating",
        description: "healing {strength} each turn",
        tags: ["magic"],
        modifiers: [HealthEachTurn(1)],
        text: (
            each_turn: (bearer: "Your wounds knit. ({amount})"),
            fades: (bearer: "Your wounds stop knitting."),
            looks: ["{bearer}'s wounds are closing before your eyes."],
        ),
    ),
    // Caught in a web (Spider Hollow's `webs`): stuck where they stand for a few seconds.
    "webbed": (
        name: "webbed",
        description: "stuck fast in sticky threads, unable to move or flee, and defending at half",
        tags: ["physical"],
        modifiers: [CantMove, CantFlee, DefenceTimes(0.5)],
        text: (
            applied: (bearer: "Sticky threads wrap around you, and you're stuck fast!", room: "{bearer} blunders into a web and is stuck fast!"),
            fades: (bearer: "You tear yourself free of the webs."),
            looks: ["{bearer} is wrapped in sticky threads."],
        ),
    ),
    // Something eaten that shouldn't have been (a deathcap): it hurts every so often while it
    // lasts, in a fight or out of one, and leaves them weak.
    "sickened": (
        name: "sickened",
        description: "sick to the stomach from something eaten, cramping now and then",
        tags: ["poison"],
        modifiers: [AttackTimes(0.75)],
        reactions: [(
            on: Every(Minutes(10)),
            effects: [Damage(amount: "roll(1, 2 + strength)", type: "physical")],
            text: (
                actor: "Your stomach knots, and the cramp {harm} you.",
                target: "Your stomach knots, and the cramp {harm} you.",
                room: "{actor} doubles over, and the cramp {harm} them.",
            ),
        )],
        text: (
            applied: (bearer: "Your stomach turns over. Something you ate was wrong.", room: "{bearer} turns a little green."),
            fades: (bearer: "Your stomach settles at last."),
            looks: ["{bearer} looks pale and sweaty."],
        ),
    ),
    "rooted": (
        name: "rooted",
        description: "unable to move or flee",
        tags: ["magic"],
        modifiers: [CantMove, CantFlee],
        text: (
            applied: (bearer: "Your feet are held fast!", room: "{bearer}'s feet are held fast!"),
            fades: (bearer: "Your feet are your own again."),
            looks: ["{bearer}'s feet are held fast to the ground."],
        ),
    ),
    "silenced": (
        name: "silenced",
        description: "unable to cast",
        tags: ["magic"],
        modifiers: [CantCast],
        text: (
            applied: (bearer: "Your voice is gone!", room: "{bearer}'s voice is gone!"),
            fades: (bearer: "Your voice comes back."),
        ),
    ),
    "shielded": (
        name: "shielded",
        description: "taking {strength} more off every blow",
        tags: ["magic"],
        modifiers: [Armour(1)],
        text: (
            fades: (bearer: "Your skin is your own again."),
            looks: ["{bearer}'s skin has a dull, stony sheen."],
        ),
    ),
    "weakened": (
        name: "weakened",
        description: "dealing a quarter less damage",
        tags: ["magic"],
        modifiers: [DamageDealt(0.75)],
        text: (
            applied: (bearer: "Your strength drains away!", room: "{bearer} sags, weakened."),
            fades: (bearer: "Your strength comes back."),
            looks: ["{bearer} looks drained."],
        ),
    ),
    "strengthened": (
        name: "strengthened",
        description: "dealing a quarter more damage",
        tags: ["magic"],
        modifiers: [DamageDealt(1.25)],
        text: (
            fades: (bearer: "Your borrowed strength ebbs."),
            looks: ["{bearer}'s muscles stand out like cords."],
        ),
    ),

    // Out of sight. Its strength is how well they hid (Stealth plus Agility); those who notice
    // them anyway still see them. Hiding puts it on, until they act openly, walk away without
    // sneaking, or fight. Who sees whom, and noticing, are in src/stealth.rs.
    // A pack hunter's boldness, a point for each of its pack fighting beside it, for its turn
    // (the `pack_hunter` trait).
    "pack_fury": (
        name: "pack fury",
        description: "emboldened by its pack: attacking {strength} better",
        tags: ["morale"],
        modifiers: [Attack(1)],
    ),
    // In a room too dark to see in (docs/world.md#light-and-darkness). The code knows this one by
    // name: it puts it on and takes it off as the light changes, and someone with it sees no one.
    "in_the_dark": (
        name: "in the dark",
        description: "unable to see for the dark, and fighting blind",
        tags: ["dark"],
        modifiers: [AttackTimes(0.5), DefenceTimes(0.5)],
    ),
    "hidden": (
        name: "hidden",
        description: "out of sight of anyone who hasn't noticed you",
        tags: ["stealth"],
        modifiers: [],
    ),

    // On locks. A door's or container's lock is shut: Lockpicking and its key take it off, and
    // its key puts it back. How hard it is to pick or force is the lock's own, in the zone file.
    "locked": (
        name: "locked",
        description: "locked",
        tags: ["lock"],
        modifiers: [],
    ),
}
