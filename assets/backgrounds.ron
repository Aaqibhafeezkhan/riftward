// Backgrounds, in the order the creation menu shows them: the life a character led before play.
// Each grants starting skills once skills exist, and can require a condition (the same language
// as skills: Stat, Race, All, Any, Not). Attributes start at 3, so a gate of 4 is one point bought
// with Karma, unless the character's race already gives it.
[
    (
        id: "soldier",
        name: "Soldier",
        summary: "You drilled, marched and fought in someone's army.",
        requires: Stat(Body, 4),
        skills: ["swordplay:basics", "endurance:toughness"],
    ),
    (
        id: "poacher",
        name: "Poacher",
        summary: "You hunted where you weren't allowed to.",
        requires: Stat(Agility, 4),
        skills: ["archery:basics", "stealth:basics"],
    ),
    (
        id: "urchin",
        name: "Street Urchin",
        summary: "You grew up on the streets, living on what you could take.",
        skills: ["stealth:basics", "thievery:pickpocketing", "thievery:lockpicking"],
    ),
    (
        id: "farmhand",
        name: "Farmhand",
        summary: "Fields, beasts and long days of honest work.",
        skills: ["survival:foraging", "brawling:basics", "animals:handling"],
    ),
    (
        id: "sailor",
        name: "Sailor",
        summary: "You worked the decks of riverboats and ships.",
        requires: Stat(Strength, 4),
        skills: ["athletics:swimming", "athletics:climbing", "knives:basics"],
    ),
    (
        id: "merchant",
        name: "Merchant's Child",
        summary: "You grew up behind a counter, learning the worth of things.",
        requires: Stat(Charisma, 4),
        skills: ["trade:haggling", "trade:appraisal"],
    ),
    (
        id: "smith",
        name: "Smith's Apprentice",
        summary: "Years at the forge, hammering iron into shape.",
        requires: Stat(Strength, 4),
        skills: ["crafting:smithing", "hammers:basics"],
    ),
    (
        id: "herbalist",
        name: "Herbalist's Apprentice",
        summary: "You gathered, dried and brewed under a healer's eye.",
        requires: Stat(Intuition, 4),
        skills: ["nature:herbalism", "healing:first_aid"],
    ),
    (
        id: "minstrel",
        name: "Minstrel",
        summary: "You sang for your supper from town to town.",
        requires: Stat(Charisma, 4),
        skills: ["performance:basics", "lore:basics"],
    ),
    (
        id: "scholar",
        name: "Scholar",
        summary: "You studied old books under older teachers.",
        requires: Stat(Logic, 4),
        skills: ["lore:basics", "crafting:scribing"],
    ),
    (
        id: "river_pilot",
        name: "River Pilot",
        summary: "You steered boats down the great rivers, as your clan always has.",
        requires: Race("tskrang"),
        skills: ["sailing:basics", "athletics:swimming"],
    ),
    (
        id: "acolyte",
        name: "Acolyte",
        summary: "You served a temple, and your faith answered. (Awakened: Divine)",
        requires: All([Stat(Magic, 1), Stat(Willpower, 4)]),
        skills: ["divine:foundation"],
    ),
    (
        id: "mystic",
        name: "Mystic",
        summary: "Spirits spoke to you before you could speak. (Awakened: Shamanic)",
        requires: All([Stat(Magic, 1), Stat(Intuition, 4)]),
        skills: ["shamanic:foundation"],
    ),
    (
        id: "apprentice",
        name: "Apprentice",
        summary: "You studied magic as a discipline under a master. (Awakened: Hermetic)",
        requires: All([Stat(Magic, 1), Stat(Logic, 4)]),
        skills: ["hermetic:foundation"],
    ),
    (
        id: "adept",
        name: "Adept",
        summary: "Your magic flows through your own body. (Awakened: Adept)",
        requires: All([Stat(Magic, 1), Stat(Body, 4)]),
        skills: ["adept:foundation"],
    ),
]
