// Backgrounds, in the order the creation menu shows them: what a character did before they were
// an adventurer. A background gives a little practice in everyday skills from that life (anyone
// can learn them later) and the tools of that life, but never fighting or magic: every adventurer
// learns those the same way, from trainers. Skills that don't exist as data yet are granted once
// they do.
//
// `requires` uses the condition language (Stat, Race, Skill, All, Any, Not). Attributes start at
// 3, so a gate of 4 is one point bought with Karma, unless the character's race already gives it.
// `items` (zone:item) come on top of everyone's plain clothes and belt pouch.
[
    (
        id: "soldier",
        name: "Soldier",
        summary: "You drilled, marched and stood your watch in someone's army.",
        requires: Stat(Body, 4),
        skills: ["athletics:toughness", "healing:first_aid"],
        items: ["riftwatch:short_sword", "riftwatch:bandage", "riftwatch:bandage"],
    ),
    (
        id: "poacher",
        name: "Poacher",
        summary: "You hunted where you weren't allowed to.",
        requires: Stat(Agility, 4),
        skills: ["stealth:basics", "survival:tracking"],
        items: ["riftwatch:knife"],
    ),
    (
        id: "urchin",
        name: "Street Urchin",
        summary: "You grew up on the streets, living on what you could take.",
        skills: ["thievery:lockpicking", "thievery:pickpocketing", "stealth:basics"],
        items: ["riftwatch:knife", "riftwatch:lockpicks"],
    ),
    (
        id: "farmhand",
        name: "Farmhand",
        summary: "Fields, beasts and long days of honest work.",
        skills: ["survival:foraging", "animals:handling"],
        items: ["riftwatch:hatchet"],
    ),
    (
        id: "sailor",
        name: "Sailor",
        summary: "You worked the decks of riverboats and ships.",
        requires: Stat(Strength, 4),
        skills: ["athletics:swimming", "athletics:climbing"],
        items: ["riftwatch:knife"],
    ),
    (
        id: "merchant",
        name: "Merchant's Child",
        summary: "You grew up behind a counter, learning the worth of things.",
        requires: Stat(Charisma, 4),
        skills: ["trade:haggling", "trade:appraisal"],
        items: ["riftwatch:knife"],
    ),
    (
        id: "smith",
        name: "Smith's Apprentice",
        summary: "Years at the forge, hammering iron into shape.",
        requires: Stat(Strength, 4),
        skills: ["crafting:smithing"],
        items: ["riftwatch:smiths_hammer"],
    ),
    (
        id: "herbalist",
        name: "Herbalist's Apprentice",
        summary: "You gathered, dried and brewed under a healer's eye.",
        requires: Stat(Intuition, 4),
        skills: ["nature:herbalism", "healing:first_aid"],
        items: ["riftwatch:knife", "riftwatch:bandage", "riftwatch:bandage"],
    ),
    (
        id: "minstrel",
        name: "Minstrel",
        summary: "You sang for your supper from town to town.",
        requires: Stat(Charisma, 4),
        skills: ["performance:basics", "lore:basics"],
        items: ["riftwatch:knife"],
    ),
    (
        id: "scholar",
        name: "Scholar",
        summary: "You studied old books under older teachers.",
        requires: Stat(Logic, 4),
        skills: ["lore:basics", "crafting:scribing"],
        items: ["riftwatch:quarterstaff"],
    ),
    (
        id: "river_pilot",
        name: "River Pilot",
        summary: "You steered boats down the great rivers, as your clan always has.",
        requires: Race("lizardfolk"),
        skills: ["sailing:basics", "athletics:swimming"],
        items: ["riftwatch:knife"],
    ),
]
