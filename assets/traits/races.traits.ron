// What every one of a race is, granted by `traits` in races.ron, players and mobs alike.
{
    // Like the elves of old tales: magic that would put them to sleep or bend their minds finds
    // little purchase.
    "fey_mind": (
        name: "Fey Mind",
        description: "an elf's mind, hard to lull or bend: resisting sleep and charm by 4 more",
        modifiers: [Withstand("sleep", 4.0), Withstand("charm", 4.0)],
    ),
}
