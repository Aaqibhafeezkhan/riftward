// The Adventurers' Guild: its ranks, what each takes, and what the clerk charges. Read when the
// server starts, so restart it after a change. See docs/quests.md#guild-ranks.
(
    name: "the Adventurers' Guild",
    // Who keeps the guild's ledgers and tags: `join guild`, a new tag and reinstatement are
    // done in front of them.
    clerk: "riftwatch:contract_clerk",
    // Copper for a new tag, when one is lost.
    tag_fee: 50,
    // A contract's merit is multiplied by this for each rank it's below its taker's, rounded
    // down: rats are a feat for a Bone member (10 merit), less so for Copper (5), and next to
    // nothing for Iron (1).
    merit_below_rank: 0.5,
    // And by this for each rank it's above (the board offers one rank up): the she-wolf's pelt,
    // a Bronze contract worth 40, is 60 to the Copper member who brings it in.
    merit_above_rank: 1.5,
    // In order, lowest first. `merit` makes a member eligible; ranks with `trial` need a
    // promotion (a trial, or a GM's `guild promote`) as well. `reinstatement` is the copper an
    // expelled member of that rank pays to come back.
    ranks: [
        (id: "bone", name: "Bone", merit: 0, tag: "riftwatch:bone_tag", reinstatement: 100),
        (id: "copper", name: "Copper", merit: 100, tag: "riftwatch:copper_tag", reinstatement: 200),
        (id: "bronze", name: "Bronze", merit: 300, tag: "riftwatch:bronze_tag", reinstatement: 350),
        (id: "iron", name: "Iron", merit: 700, tag: "riftwatch:iron_tag", reinstatement: 500),
        (id: "silver", name: "Silver", merit: 1500, trial: true, tag: "riftwatch:silver_tag", reinstatement: 1000),
        (id: "gold", name: "Gold", merit: 3500, trial: true, tag: "riftwatch:gold_tag", reinstatement: 2500),
        (id: "platinum", name: "Platinum", merit: 8000, trial: true, tag: "riftwatch:platinum_tag", reinstatement: 5000),
    ],
)
