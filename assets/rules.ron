// The game's rules in numbers. Read when the server starts, so restart it after a change.
// See docs/architecture.md#data.
(
    // Seconds in a combat round: everyone fighting acts once in each, in order of initiative.
    round_seconds: 3.0,
    // Seconds an action (eating, picking a lock) takes outside a fight before the next can start;
    // in a fight each takes a round.
    action_seconds: 1.0,
    // Seconds a prepared spell or opener (Backstab) can wait for its first turn before it fades.
    ready_timeout_seconds: 5.0,
    // Stamina it takes to flee, and the chance of getting away, before Luck.
    flee_stamina: 2.0,
    flee_chance: 0.6,
    // Stamina a riposte costs.
    riposte_stamina: 1.0,
    // The chance, in percent, that a mob uses a combat skill on its turn instead of its
    // auto-attack, unless its template sets its own `tactics`.
    mob_tactics: 25,
    // Most health is base_vitals + Body / attribute_per_vital, and most stamina the same with
    // Willpower, before passive skills add to them: 8 + Body / 2.
    base_vitals: 8,
    attribute_per_vital: 2,
    // Real minutes for health, and stamina, to recover from nothing to full out of a fight, and
    // how much faster resting makes it.
    health_recovery_minutes: 10.0,
    stamina_recovery_minutes: 2.0,
    rest_speedup: 3.0,
    // Drain is resisted against a spell's stamina cost times this, as a fixed difficulty.
    drain_difficulty: 2.0,
    // How much better a deliberate `search` is than a passing glance: Intuition times this.
    search_bonus: 2.0,
    // About how many real minutes between ambient lines (`chatter` on mobs and rooms) in a room
    // with a player in it: a crow cawing, water dripping. See docs/world.md#ambient-lines.
    chatter_minutes: 1.5,
    // Real seconds a mob born hidden (a spider in its web) stays in sight, out of a fight,
    // before it hides again. See docs/world.md, under mob templates.
    rehide_seconds: 60.0,
    // A failed climb is a fall: down to the bottom, or back where the climb began, and on through
    // any open drop below. Each room fallen through hurts this much, rolled, so a longer fall
    // hurts more: one room (the East Road to the Ravine Floor) is 1 to 6, two rooms 2 to 12. A
    // fall can kill. See docs/world.md#climbing-and-swimming.
    fall_damage_per_room: (1, 6),
    // Tracks (docs/world.md#tracking): rooms remember who walked in or out for this many real
    // minutes, the most recent `most` of them. Reading one is Tracking against how hard its
    // ground is, a formula in survival.skill.ron; wading water holds none. Ages read as the
    // words of the first band they're under, youngest first, else `older`.
    tracks: (
        minutes: 30.0,
        most: 20,
        ground: (mud: 1.0, uneven: 3.0, rough: 5.0, road: 6.0, paved: 8.0),
        ages: [(5.0, "fresh"), (15.0, "recent")],
        older: "old",
    ),
    // Foraging and Herbalism (docs/world.md#environment-and-finds): each room holds this many
    // finds of each kind, and grows one back every so many real minutes.
    finds: (patch: 3, regrow_minutes: 10.0),
    // Shops (docs/economy.md): they pay this share of an item's value before haggling. A won
    // haggle moves prices that share of its value your way, for so many real minutes, by how
    // surely it was won (as blows are graded), and reads as its words.
    trade: (
        buying_share: 0.3333333333,
        deal_minutes: 10.0,
        glancing: (share: 0.05, words: "a little"),
        solid: (share: 0.10, words: "a tenth"),
        strong: (share: 0.15, words: "a good way"),
        crushing: (share: 0.20, words: "a fifth"),
    ),
    // Crafting (docs/crafting.md): fine and rare ingredients are harder to work. A recipe's
    // difficulty is multiplied by fine_makings for each step their average quality is above
    // standard, and by rare_makings for each step the rarest is above common (uncommon 1 up to
    // legendary 4). Contests go by the ratio rule, so doubling the difficulty wants about twice
    // the skill for the same chance: legendary meat (×16) wants a master cook.
    crafting: (fine_makings: 1.5, rare_makings: 2.0),
)
